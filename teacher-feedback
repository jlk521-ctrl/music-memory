            async function syncGroupsFieldAcrossRoster(studentId, groupIds) {
                // Keeps each class's roster entry for this student stamped with their full,
                // current list of enrolled classes - this is what lets Class Summary work out
                // which classes to pull rollups from for a student without reading their
                // student doc. Bounded by how many classes one student is in (typically 1-3),
                // so this stays cheap even though it touches multiple class docs.
                for (const gId of groupIds) {
                    try {
                        const gRef = doc(db, `artifacts/${appId}/public/data/groups`, gId);
                        const gSnap = await getDoc(gRef);
                        if (!gSnap.exists()) continue;
                        const members = gSnap.data().members || [];
                        const idx = members.findIndex(m => m.id === studentId);
                        if (idx === -1) continue;
                        if (JSON.stringify(members[idx].groups || []) === JSON.stringify(groupIds)) continue; // already current
                        const updatedMembers = [...members];
                        updatedMembers[idx] = { ...updatedMembers[idx], groups: groupIds };
                        await updateDoc(gRef, { members: updatedMembers });
                        const cachedGroup = classSchedules.find(g => g.id === gId);
                        if (cachedGroup) cachedGroup.members = updatedMembers;
                    } catch (error) {
                        console.error(`Error syncing groups field onto roster for class ${gId}:`, error);
                    }
                }
            }

            async function addStudentToClassAboutMe(studentId, studentName, classId) {
                if (!classId) {
                    showPersistentMessage("Please select a class to add.");
                    return;
                }
                try {
                    const studentRef = doc(db, `artifacts/${appId}/public/data/students`, studentId);
                    const studentSnap = await getDoc(studentRef);
                    const studentData = studentSnap.exists() ? studentSnap.data() : {};
                    const aboutMe = studentData.aboutMe || {};
                    const currentGroups = studentData.groups || [];

                    if (currentGroups.includes(classId)) {
                        showPersistentMessage("Already enrolled in that class.");
                        return;
                    }

                    const groupRef = doc(db, `artifacts/${appId}/public/data/groups`, classId);
                    const groupSnap = await getDoc(groupRef);
                    if (!groupSnap.exists()) {
                        showPersistentMessage("Could not find that class.");
                        return;
                    }
                    const members = groupSnap.data().members || [];
                    const newGroups = Array.from(new Set([...currentGroups, classId]));
                    if (!members.some(m => m.id === studentId)) {
                        const updatedMembers = [...members, {
                            id: studentId,
                            name: studentData.name || studentName,
                            birthdate: aboutMe.birthdate || '',
                            icons: aboutMe.icons || [],
                            iconNotes: aboutMe.iconNotes || {},
                            groups: newGroups,
                            aboutMeSynced: true
                        }];
                        await updateDoc(groupRef, { members: updatedMembers });
                        const cachedGroup = classSchedules.find(g => g.id === classId);
                        if (cachedGroup) cachedGroup.members = updatedMembers;
                    }

                    await updateDoc(studentRef, { groups: newGroups });
                    // Keep the student's existing classes' rosters in sync too, so the
                    // Class Summary cross-class rollup lookup (which reads each roster
                    // entry's own denormalized `groups` field) doesn't go stale on any of them.
                    await syncGroupsFieldAcrossRoster(studentId, newGroups);

                    showPersistentMessage(`Added ${studentName} to "${classId}".`);
                    renderAboutMeClassList(studentId, newGroups);

                    if (currentClassId === classId) {
                        await loadClass(currentClassId, true);
                    }
                } catch (error) {
                    console.error("Error adding student to class:", error);
                    showPersistentMessage("Failed to add to class. See console for details.");
                }
            }

            async function removeStudentFromClassAboutMe(studentId, classId) {
                if (!(await showAppConfirm(`Remove this student from "${classId}"?`, 'Remove'))) return;
                try {
                    const groupRef = doc(db, `artifacts/${appId}/public/data/groups`, classId);
                    const groupSnap = await getDoc(groupRef);
                    if (groupSnap.exists()) {
                        const updatedMembers = (groupSnap.data().members || []).filter(m => m.id !== studentId);
                        await updateDoc(groupRef, { members: updatedMembers });
                        const cachedGroup = classSchedules.find(g => g.id === classId);
                        if (cachedGroup) cachedGroup.members = updatedMembers;
                    }

                    const studentRef = doc(db, `artifacts/${appId}/public/data/students`, studentId);
                    const studentSnap = await getDoc(studentRef);
                    const currentGroups = studentSnap.exists() ? (studentSnap.data().groups || []) : [];
                    const newGroups = currentGroups.filter(g => g !== classId);
                    await updateDoc(studentRef, { groups: newGroups });
                    await syncGroupsFieldAcrossRoster(studentId, newGroups);

                    showPersistentMessage(`Removed from "${classId}".`);
                    renderAboutMeClassList(studentId, newGroups);

                    if (currentClassId === classId) {
                        await loadClass(currentClassId, true);
                    }
                } catch (error) {
                    console.error("Error removing student from class:", error);
                    showPersistentMessage("Failed to remove from class. See console for details.");
                }
            }

