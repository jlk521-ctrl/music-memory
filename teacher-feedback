            // --- STUDENT MANAGEMENT LOGIC ---

            // --- BULK ROSTER IMPORT ---

            function convertRosterDob(dobStr) {
                // "MM/DD/YY" or "MM/DD/YYYY" -> "YYYY-MM-DD" (for the About Me date input)
                if (!dobStr) return '';
                const match = dobStr.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/);
                if (!match) return '';
                const [, mm, dd, yy] = match;
                const year = yy.length === 4
                    ? parseInt(yy, 10)
                    : (parseInt(yy, 10) <= 49 ? 2000 + parseInt(yy, 10) : 1900 + parseInt(yy, 10));
                return `${year}-${mm.padStart(2, '0')}-${dd.padStart(2, '0')}`;
            }

            function parseBulkRoster(text) {
                const lines = text.split('\n').map(l => l.replace(/\r$/, '')).filter(l => l.trim() !== '');
                const rows = [];
                const skipped = [];

                lines.forEach(line => {
                    const cols = line.split('\t').map(c => c.trim());
                    if (cols.length < 5) {
                        skipped.push(line);
                        return;
                    }
                    const [name, id, dob, gender, classRaw, phone] = cols;
                    if (!/^\d+$/.test(id) || !name || !classRaw) {
                        skipped.push(line);
                        return;
                    }
                    // Used exactly as given, including any leading grade digit - nothing stripped.
                    const className = classRaw.trim();
                    rows.push({
                        id,
                        name,
                        className,
                        birthdate: convertRosterDob(dob),
                        gender: (gender || '').trim(),
                        parentContact: (phone || '').trim()
                    });
                });

                return { rows, skipped };
            }

            async function previewBulkImport() {
                const text = document.getElementById('bulk-import-data').value;
                const { rows, skipped } = parseBulkRoster(text);
                const summaryEl = document.getElementById('bulk-import-summary');
                const confirmBtn = document.getElementById('bulk-import-confirm-btn');

                if (rows.length === 0) {
                    showPersistentMessage("No valid rows found. Make sure each line has Name, Student ID, DOB, Gender, Class, and Primary # separated by tabs.");
                    return;
                }

                summaryEl.innerHTML = '<p>Analyzing roster...</p>';
                summaryEl.classList.remove('hidden');
                confirmBtn.classList.add('hidden');

                try {
                    // Refresh known classes so the new-vs-existing check is accurate
                    await populateClassSelect();
                    const existingClassIds = new Set(classSchedules.map(g => g.id));

                    // Pull every existing student record in one read
                    const studentsSnapshot = await getDocs(collection(db, `artifacts/${appId}/public/data/students`));
                    const existingStudents = new Map();
                    studentsSnapshot.forEach(d => existingStudents.set(d.id, d.data()));

                    // Group pasted rows by class name (deduped by student id within a class)
                    const classMembersMap = new Map();
                    rows.forEach(({ id, name, className }) => {
                        if (!classMembersMap.has(className)) classMembersMap.set(className, []);
                        const list = classMembersMap.get(className);
                        if (!list.some(m => m.id === id)) list.push({ id, name });
                    });

                    const newClasses = new Map();
                    const existingClassesInData = [];
                    classMembersMap.forEach((members, className) => {
                        if (existingClassIds.has(className)) {
                            existingClassesInData.push(className);
                        } else {
                            newClasses.set(className, members);
                        }
                    });

                    // Most recent name/About-Me values per student ID across the pasted rows
                    const latestById = new Map();
                    rows.forEach(row => latestById.set(row.id, row));

                    // Consolidate every change for a given student ID into one entry,
                    // so each student doc only gets written once at commit time.
                    const studentWrites = new Map();
                    latestById.forEach((row, id) => {
                        const existing = existingStudents.get(id);
                        const entry = studentWrites.get(id) || {};
                        if (!existing) {
                            entry.name = row.name;
                            entry.isNew = true;
                        } else if ((existing.name || '') !== row.name) {
                            entry.name = row.name;
                        }
                        // Birthdate/gender/Primary # come from the official roster every import;
                        // Teacher Notes and Quick Reminder Icons are never touched here.
                        entry.aboutMe = {
                            birthdate: row.birthdate,
                            gender: row.gender,
                            parentContact: row.parentContact
                        };
                        studentWrites.set(id, entry);
                    });
                    newClasses.forEach((members, className) => {
                        members.forEach(({ id }) => {
                            const existing = existingStudents.get(id);
                            const entry = studentWrites.get(id) || {};
                            if (!entry.addGroups) entry.addGroups = new Set(existing?.groups || []);
                            entry.addGroups.add(className);
                            studentWrites.set(id, entry);
                        });
                    });

                    const nameUpdates = [];
                    let newStudentCount = 0;
                    studentWrites.forEach((entry, id) => {
                        if (entry.isNew) {
                            newStudentCount++;
                        } else if (entry.name !== undefined) {
                            nameUpdates.push({ id, oldName: existingStudents.get(id)?.name || '(blank)', newName: entry.name });
                        }
                    });

                    bulkImportPlan = { newClasses, studentWrites, existingStudents };

                    let html = '';
                    html += `<p><strong>${rows.length}</strong> valid row(s) parsed${skipped.length ? `, <strong>${skipped.length}</strong> line(s) skipped` : ''}.</p>`;
                    html += `<p><strong>${newClasses.size}</strong> new class(es) will be created${newClasses.size ? ': ' + [...newClasses.keys()].join(', ') : ''}.</p>`;
                    html += `<p><strong>${existingClassesInData.length}</strong> class(es) in the paste already exist and will NOT be modified${existingClassesInData.length ? ': ' + existingClassesInData.join(', ') : ''}.</p>`;
                    html += `<p><strong>${newStudentCount}</strong> new student record(s) will be created.</p>`;
                    html += `<p><strong>${studentWrites.size}</strong> student(s) will have their About Me birthdate/gender/Primary # synced from this roster (Teacher Notes and Quick Reminder Icons are left untouched).</p>`;
                    html += `<p><strong>${nameUpdates.length}</strong> existing student name(s) will be updated${nameUpdates.length ? ':' : '.'}</p>`;
                    if (nameUpdates.length > 0) {
                        html += '<ul style="max-height: 140px; overflow-y: auto; color: #bdc3c7; margin: 0.25rem 0 0 1rem;">';
                        nameUpdates.slice(0, 50).forEach(u => {
                            html += `<li>${u.id}: "${u.oldName}" &rarr; "${u.newName}"</li>`;
                        });
                        if (nameUpdates.length > 50) html += `<li>...and ${nameUpdates.length - 50} more</li>`;
                        html += '</ul>';
                    }
                    if (skipped.length > 0) {
                        html += `<p style="color: #e74c3c; margin-top: 0.5rem;">Skipped lines (missing/invalid data):</p>`;
                        html += '<ul style="max-height: 100px; overflow-y: auto; color: #e74c3c; margin: 0.25rem 0 0 1rem;">';
                        skipped.slice(0, 20).forEach(l => html += `<li>${l}</li>`);
                        if (skipped.length > 20) html += `<li>...and ${skipped.length - 20} more</li>`;
                        html += '</ul>';
                    }

                    summaryEl.innerHTML = html;
                    confirmBtn.classList.remove('hidden');

                } catch (error) {
                    console.error("Error analyzing bulk import:", error);
                    summaryEl.innerHTML = '<p style="color: #e74c3c;">Failed to analyze the pasted roster. See console for details.</p>';
                    bulkImportPlan = null;
                }
            }

            async function confirmBulkImport() {
                if (!bulkImportPlan) return;
                const { newClasses, studentWrites, existingStudents } = bulkImportPlan;
                const confirmBtn = document.getElementById('bulk-import-confirm-btn');
                confirmBtn.disabled = true;

                try {
                    const writes = [];

                    newClasses.forEach((members, className) => {
                        const enrichedMembers = members.map(m => {
                            const writeEntry = studentWrites.get(m.id);
                            const existing = existingStudents.get(m.id);
                            return {
                                id: m.id,
                                name: m.name,
                                birthdate: writeEntry?.aboutMe?.birthdate || '',
                                icons: existing?.aboutMe?.icons || [],
                                iconNotes: existing?.aboutMe?.iconNotes || {},
                                groups: Array.from(new Set([...(existing?.groups || []), className])),
                                aboutMeSynced: true
                            };
                        });
                        writes.push({ ref: doc(db, `artifacts/${appId}/public/data/groups`, className), data: { members: enrichedMembers } });
                    });

                    studentWrites.forEach((entry, id) => {
                        const data = {};
                        if (entry.name !== undefined) data.name = entry.name;
                        if (entry.addGroups) data.groups = Array.from(entry.addGroups);
                        if (entry.aboutMe) data.aboutMe = entry.aboutMe;
                        if (entry.isNew) {
                            data.totalPositive = 0;
                            data.totalNegative = 0;
                            if (data.groups === undefined) data.groups = existingStudents.get(id)?.groups || [];
                        }
                        writes.push({ ref: doc(db, `artifacts/${appId}/public/data/students`, id), data });
                    });

                    // Commit in chunks to stay well under Firestore's per-batch write limit
                    const chunkSize = 400;
                    for (let i = 0; i < writes.length; i += chunkSize) {
                        const batch = writeBatch(db);
                        writes.slice(i, i + chunkSize).forEach(w => batch.set(w.ref, w.data, { merge: true }));
                        await batch.commit();
                    }

                    showPersistentMessage(`Bulk import complete: ${newClasses.size} new class(es), ${studentWrites.size} student record(s) touched.`);

                    document.getElementById('bulk-import-data').value = '';
                    document.getElementById('bulk-import-summary').classList.add('hidden');
                    confirmBtn.classList.add('hidden');
                    bulkImportPlan = null;

                    await populateClassSelect();
                    populateManageClassesSelects();

                } catch (error) {
                    console.error("Error committing bulk import:", error);
                    showPersistentMessage("Bulk import failed partway through. Some records may already be updated - check the console for details before retrying.");
                } finally {
                    confirmBtn.disabled = false;
                }
            }

            async function createNewClass(e) {
                e.preventDefault();
                const classId = document.getElementById('new-class-id').value.trim();
                const description = document.getElementById('new-class-description').value.trim();
                const rawIds = document.getElementById('new-class-students').value;

                if (!classId) {
                    showPersistentMessage("Please enter a class name/ID.");
                    return;
                }
                if (classSchedules.some(c => c.id === classId)) {
                    showPersistentMessage(`A class named "${classId}" already exists.`);
                    return;
                }

                const enteredIds = Array.from(new Set(
                    rawIds.split('\n').map(s => s.trim()).filter(Boolean)
                ));

                const invalidIds = enteredIds.filter(id => !/^\d+$/.test(id));
                const validIds = enteredIds.filter(id => /^\d+$/.test(id));

                if (invalidIds.length > 0) {
                    const proceed = await showAppConfirm(
                        `These lines aren't valid numeric Student IDs and will be skipped:\n${invalidIds.join('\n')}\n\nCreate the class with the remaining ${validIds.length} student(s)?`,
                        'Create Class'
                    );
                    if (!proceed) return;
                }

                const days = Array.from(document.querySelectorAll('.new-class-day:checked')).map(cb => parseInt(cb.value, 10)).sort((a, b) => a - b);
                const startTime = document.getElementById('new-class-start').value;
                const endTime = document.getElementById('new-class-end').value;

                let schedule = null;
                if (days.length > 0 && startTime && endTime) {
                    schedule = { days, start: `${startTime}:00`, end: `${endTime}:00` };
                } else if (days.length > 0 || startTime || endTime) {
                    showPersistentMessage("Please select at least one meeting day and both start/end times together, or leave all of them blank.");
                    return;
                }

                try {
                    const members = [];
                    const batch = writeBatch(db);

                    for (const id of validIds) {
                        const studentRef = doc(db, `artifacts/${appId}/public/data/students`, id);
                        const studentSnap = await getDoc(studentRef);

                        let name;
                        const existingAboutMe = studentSnap.exists() ? (studentSnap.data().aboutMe || {}) : {};
                        const existingGroups = studentSnap.exists() ? (studentSnap.data().groups || []) : [];
                        const newGroupsForMember = Array.from(new Set([...existingGroups, classId]));
                        if (studentSnap.exists() && studentSnap.data().name) {
                            // Name already on file for this Student ID - reuse it.
                            name = studentSnap.data().name;
                            batch.update(studentRef, { groups: newGroupsForMember });
                        } else {
                            // No name on file yet - default the display name to the Student ID.
                            name = id;
                            batch.set(studentRef, { name, groups: [classId], totalPositive: 0, totalNegative: 0 }, { merge: true });
                        }
                        members.push({
                            id, name,
                            birthdate: existingAboutMe.birthdate || '',
                            icons: existingAboutMe.icons || [],
                            iconNotes: existingAboutMe.iconNotes || {},
                            groups: newGroupsForMember,
                            aboutMeSynced: true
                        });
                    }

                    const groupRef = doc(db, `artifacts/${appId}/public/data/groups`, classId);
                    const groupData = { members };
                    if (schedule) groupData.schedule = schedule;
                    if (description) groupData.description = description;
                    batch.set(groupRef, groupData);

                    await batch.commit();

                    showPersistentMessage(`Created class "${classId}" with ${members.length} student(s).`);
                    manageClassesModal.classList.add('hidden');
                    document.getElementById('add-class-form').reset();

                    await populateClassSelect();
                    classSelect.value = classId;
                    autoSelectPerformed = true;
                    await loadClass(classId);

                } catch (error) {
                    console.error("Error creating class:", error);
                    showPersistentMessage("Failed to create class. See console for details.");
                }
            }

