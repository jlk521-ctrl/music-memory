            async function populateClassSelect() {
                const groupsRef = collection(db, `artifacts/${appId}/public/data/groups`);
                const querySnapshot = await getDocs(groupsRef);
                
                classSchedules = querySnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                const sortedGroups = [...classSchedules].sort((a, b) => a.id.localeCompare(b.id));

                const previouslySelected = classSelect.value;

                classSelect.innerHTML = '<option value="">Select a class...</option>';
                const summarySelect = document.getElementById('class-select-summary');
                summarySelect.innerHTML = '';

                sortedGroups.forEach(group => {
                    // Archived classes are hidden everywhere except the Unarchive dropdown.
                    if (group.archived) return;

                    const option = document.createElement('option');
                    option.value = option.textContent = group.id;
                    classSelect.appendChild(option);

                    const summaryOption = document.createElement('option');
                    summaryOption.value = group.id;
                    summaryOption.textContent = group.id;
                    summarySelect.appendChild(summaryOption);
                });

                // Rebuilding the <select> above always resets its displayed value to the
                // blank default option, even though the roster on screen hasn't actually
                // changed - restore it so the dropdown doesn't look like the class was
                // deselected every time something elsewhere triggers a refresh.
                if (previouslySelected && [...classSelect.options].some(o => o.value === previouslySelected)) {
                    classSelect.value = previouslySelected;
                }
            }

            // Rebuilds "this session" as "today" for a class: reads today's actual logged
            // feedback for that class once, and derives both the score/count/emoji trail
            // (from every non-status entry) and each student's current absent/not-absent
            // status (from whichever of Absent/Not Absent was logged most recently for
            // them today) from that same single read. This is what lets the cards reflect
            // a full day's activity across reloads and class switches, rather than
            // resetting to zero every time - and it costs one query scoped to one class's
            // one day, not a whole-roster or whole-history read.
            async function buildTodaySessionState(classId) {
                const result = { sessionStats: {}, absentStudentIds: new Set() };
                try {
                    const q = query(collection(db, `artifacts/${appId}/public/data/feedback`), where('class', '==', classId));
                    const snap = await getDocs(q);
                    const todayStr = getLocalDateString();

                    const entries = snap.docs
                        .map(d => d.data())
                        .filter(e => e.timestamp && getLocalDateString(e.timestamp.toDate()) === todayStr)
                        .sort((a, b) => a.timestamp.toDate() - b.timestamp.toDate()); // chronological, so the last Absent/Not Absent entry per student is simply whichever we see last

                    entries.forEach(entry => {
                        const id = entry.studentId;
                        if (!id) return;

                        if (entry.behavior === 'Absent') {
                            result.absentStudentIds.add(id);
                            return; // status marker - doesn't touch count/score/emoji trail
                        }
                        if (entry.behavior === 'Not Absent') {
                            result.absentStudentIds.delete(id);
                            return;
                        }

                        if (!result.sessionStats[id]) {
                            result.sessionStats[id] = { count: 0, score: 0, emojis: [] };
                        }
                        result.sessionStats[id].count += 1;
                        result.sessionStats[id].score += (entry.points || 0);
                        if (behaviorEmojis[entry.behavior]) {
                            result.sessionStats[id].emojis.push(behaviorEmojis[entry.behavior]);
                        }
                    });
                } catch (error) {
                    console.error("Error rebuilding today's session state:", error);
                }
                return result;
            }

            async function loadClass(groupId, preserveSession = false) {
                if (!groupId) {
                    studentGrid.innerHTML = '<p>Please select a class to see the student roster.</p>';
                    currentClassElement.textContent = 'No class selected';
                    currentClassMembers = [];
                    document.getElementById('lesson-objective').value = '';
                    document.getElementById('lesson-misconceptions').value = '';
                    return;
                }
                // preserveSession=true is used when we're only re-rendering the roster after
                // an edit (renamed/added/removed a student, etc.) rather than the teacher
                // actually switching to a different class/period - in that case whatever is
                // already in memory is already correct and shouldn't be touched.
                //
                // Otherwise (a genuine class switch, schedule auto-select, or page load),
                // "session" means "today" - rebuilt from today's actual logged entries for
                // this class, so scores/counts/emoji trails/absent status all survive
                // reloads and switching back and forth between classes during the day. The
                // bus rider alarm dismissal deliberately still resets every time regardless -
                // it should keep firing as dismissal approaches even if it was dismissed
                // earlier today, including from a different device.
                busRiderAlarmDismissed.clear();
                currentClassId = groupId;
                studentGrid.innerHTML = '<p>Loading roster...</p>';
                if (!preserveSession) {
                    const todayState = await buildTodaySessionState(groupId);
                    sessionStats = todayState.sessionStats;
                    absentStudentIds = todayState.absentStudentIds;
                }

                const groupData = classSchedules.find(g => g.id === groupId);
                currentClassElement.textContent = groupData && groupData.description
                    ? `Current Class: ${groupId} — ${groupData.description}`
                    : `Current Class: ${groupId}`;

                if (groupData && groupData.members) {
                    const gridSortMode = document.getElementById('grid-sort-select')?.value || 'first-asc';
                    currentClassMembers = groupData.members.sort((a, b) => compareStudentsForSort(a, b, gridSortMode));
                    studentGrid.innerHTML = '';
                    currentClassMembers.forEach(student => {
                        const existingStats = sessionStats[student.id];
                        if (!existingStats) {
                            sessionStats[student.id] = { count: 0, score: 0, emojis: [] };
                        }
                        const card = document.createElement('div');
                        card.className = 'student-card';
                        card.dataset.studentName = student.name;
                        card.dataset.studentId = student.id;
                        card.innerHTML = `<div class="card-emoji-row" data-emoji-for="${student.id}"></div>
                            <span class="card-birthday-badge hidden" data-birthday-for="${student.id}" title="Birthday coming up!">🎂</span>
                            <div class="student-name">${student.name}</div>
                            <div class="card-score positive" data-score-for="${student.id}">0</div>
                            <div class="card-id-row">
                                <button type="button" class="card-id-btn" data-id-btn-for="${student.id}" title="About Me">🪪</button>
                                <span class="card-about-icons" data-icons-for="${student.id}"></span>
                            </div>
                            <div class="card-count" data-count-for="${student.id}">🔁 0</div>`;
                        card.addEventListener('click', () => {
                            currentStudent = { name: student.name, id: student.id };
                            document.getElementById('modal-student-name').textContent = `Feedback for ${student.name}`;
                            feedbackModal.classList.remove('hidden');
                            if (busRiderAlarmDismissed && !busRiderAlarmDismissed.has(student.id)) {
                                busRiderAlarmDismissed.add(student.id);
                                card.classList.remove('bus-rider-alarm');
                            }
                        });
                        card.querySelector('.card-id-btn').addEventListener('click', (e) => {
                            e.stopPropagation();
                            openAboutMeModal(student.id, student.name);
                        });
                        studentGrid.appendChild(card);

                        // Restore today's already-collected score/count/emoji trail onto the
                        // freshly rebuilt card instead of leaving it at the default 0/blank.
                        if (existingStats) {
                            const scoreEl = card.querySelector(`[data-score-for="${student.id}"]`);
                            const countEl = card.querySelector(`[data-count-for="${student.id}"]`);
                            const emojiEl = card.querySelector(`[data-emoji-for="${student.id}"]`);
                            if (scoreEl) {
                                scoreEl.textContent = existingStats.score.toFixed(1).replace(/\.0$/, '');
                                scoreEl.classList.toggle('positive', existingStats.score >= 0);
                                scoreEl.classList.toggle('negative', existingStats.score < 0);
                            }
                            if (countEl) countEl.textContent = `🔁 ${existingStats.count}`;
                            if (emojiEl) emojiEl.textContent = existingStats.emojis.join('');
                            if (existingStats.count > 0) card.classList.add('last-logged');
                        }
                        if (absentStudentIds.has(student.id)) {
                            card.classList.add('absent');
                        }

                        // About Me icons/birthday are denormalized directly onto each member
                        // entry (see saveAboutMe), so rendering them costs zero extra reads.
                        applyAboutMeDisplayToCard(student.id, student.icons || [], student.iconNotes || {}, student.birthdate || '');
                    });
                    updateBusRiderAlarms();

                    // Self-heal: any member entry that predates this denormalization (or was
                    // added by a path that couldn't look it up at the time) won't have
                    // aboutMeSynced set yet. Fetch just those students' docs once, render them,
                    // then write the whole roster back in a single update so every future load
                    // of this class costs zero extra reads.
                    const staleMembers = currentClassMembers.filter(s => !s.aboutMeSynced);
                    if (staleMembers.length > 0) {
                        Promise.all(staleMembers.map(async student => {
                            try {
                                const snap = await getDoc(doc(db, `artifacts/${appId}/public/data/students`, student.id));
                                const aboutMe = snap.exists() ? (snap.data().aboutMe || {}) : {};
                                return {
                                    id: student.id,
                                    birthdate: aboutMe.birthdate || '',
                                    icons: aboutMe.icons || [],
                                    iconNotes: aboutMe.iconNotes || {},
                                    groups: snap.exists() ? (snap.data().groups || [groupId]) : [groupId]
                                };
                            } catch (error) {
                                console.error(`Error syncing About Me info for ${student.id}:`, error);
                                return { id: student.id, birthdate: '', icons: [], iconNotes: {}, groups: [groupId] };
                            }
                        })).then(async updates => {
                            const updateMap = new Map(updates.map(u => [u.id, u]));
                            const newMembers = groupData.members.map(m => {
                                if (!updateMap.has(m.id)) return m;
                                const u = updateMap.get(m.id);
                                return { ...m, birthdate: u.birthdate, icons: u.icons, iconNotes: u.iconNotes, groups: u.groups, aboutMeSynced: true };
                            });

                            updates.forEach(u => applyAboutMeDisplayToCard(u.id, u.icons, u.iconNotes, u.birthdate));

                            try {
                                await updateDoc(doc(db, `artifacts/${appId}/public/data/groups`, groupId), { members: newMembers });
                                groupData.members = newMembers; // keep the in-memory cache consistent too
                                if (currentClassId === groupId) {
                                    currentClassMembers = newMembers;
                                    updateBusRiderAlarms();
                                }
                            } catch (error) {
                                console.error("Error persisting About Me sync to group doc:", error);
                            }
                        });
                    }
                } else {
                    currentClassMembers = [];
                    studentGrid.innerHTML = `<p style="color: #e74c3c;">Error: Could not find data for class "${groupId}".</p>`;
                }

                await loadLessonNotes(groupId);
            }

            async function loadLessonNotes(groupId) {
                const objectiveInput = document.getElementById('lesson-objective');
                const notesInput = document.getElementById('lesson-misconceptions');
                const docId = `${groupId}_${getLocalDateString()}`;
                try {
                    const noteSnap = await getDoc(doc(db, `artifacts/${appId}/public/data/lessonNotes`, docId));
                    if (noteSnap.exists()) {
                        const data = noteSnap.data();
                        objectiveInput.value = data.lessonObjective || '';
                        notesInput.value = data.notes || '';
                    } else {
                        objectiveInput.value = '';
                        notesInput.value = '';
                    }
                } catch (error) {
                    console.error("Error loading lesson notes:", error);
                }
            }

            async function saveLessonNotes() {
                if (!currentClassId) return; // nothing to associate the notes with yet
                const lessonObjective = document.getElementById('lesson-objective').value.trim();
                const notes = document.getElementById('lesson-misconceptions').value.trim();
                const todayStr = getLocalDateString();
                const docId = `${currentClassId}_${todayStr}`;
                try {
                    await setDoc(doc(db, `artifacts/${appId}/public/data/lessonNotes`, docId), {
                        class: currentClassId,
                        lessonObjective,
                        notes,
                        date: todayStr,
                        lastUpdated: new Date()
                    }, { merge: true });
                } catch (error) {
                    console.error("Error saving lesson notes:", error);
                }
            }

            function filterStudents() {
                // Only the first word is used for live filtering, so notes typed/dictated
                // after the name (e.g. "Jason not paying attention") don't break the match.
                const firstWord = (searchBar.value.trim().split(/\s+/)[0] || '').toLowerCase();
                studentGrid.querySelectorAll('.student-card').forEach(card => {
                    card.style.display = card.dataset.studentName.toLowerCase().includes(firstWord) ? '' : 'none';
                });
            }
            
            function formatTime(timeStr) {
                if (!timeStr) return null;
                let [hours, minutes, seconds] = timeStr.split(':');
                return `${hours.padStart(2, '0')}:${minutes.padStart(2, '0')}:${(seconds || '00').padStart(2, '0')}`;
            }

            function getScheduleDays(group) {
                // Supports the current multi-day shape ({days:[...]}) as well as the
                // older single-day shape ({day: n}) saved by earlier versions of the app.
                if (!group || !group.schedule) return [];
                if (Array.isArray(group.schedule.days)) return group.schedule.days;
                if (group.schedule.day !== undefined && group.schedule.day !== null) return [group.schedule.day];
                return [];
            }

            function formatTime12hr(timeStr) {
                if (!timeStr) return '';
                const [h, m] = timeStr.split(':').map(Number);
                const period = h >= 12 ? 'PM' : 'AM';
                const hour12 = h % 12 === 0 ? 12 : h % 12;
                return `${hour12}:${String(m).padStart(2, '0')} ${period}`;
            }

            function getFirstLastName(fullName) {
                // First token is treated as the first name, last whitespace-separated token
                // as the last name - matches this app's "First L." / "First Last" convention
                // closely enough for sorting purposes.
                const parts = (fullName || '').trim().split(/\s+/).filter(Boolean);
                if (parts.length === 0) return { first: '', last: '' };
                return { first: parts[0], last: parts[parts.length - 1] };
            }

            function compareStudentsForSort(a, b, sortMode) {
                switch (sortMode) {
                    case 'score-desc': {
                        const scoreA = sessionStats[a.id]?.score || 0;
                        const scoreB = sessionStats[b.id]?.score || 0;
                        if (scoreB !== scoreA) return scoreB - scoreA;
                        return getFirstLastName(a.name).first.localeCompare(getFirstLastName(b.name).first);
                    }
                    case 'score-asc': {
                        const scoreA = sessionStats[a.id]?.score || 0;
                        const scoreB = sessionStats[b.id]?.score || 0;
                        if (scoreA !== scoreB) return scoreA - scoreB;
                        return getFirstLastName(a.name).first.localeCompare(getFirstLastName(b.name).first);
                    }
                    case 'first-desc': return getFirstLastName(b.name).first.localeCompare(getFirstLastName(a.name).first);
                    case 'last-asc': return getFirstLastName(a.name).last.localeCompare(getFirstLastName(b.name).last);
                    case 'last-desc': return getFirstLastName(b.name).last.localeCompare(getFirstLastName(a.name).last);
                    case 'first-asc':
                    default: return getFirstLastName(a.name).first.localeCompare(getFirstLastName(b.name).first);
                }
            }

            function sortStudentGrid(sortMode) {
                if (!currentClassMembers || currentClassMembers.length === 0) return;
                const sorted = [...currentClassMembers].sort((a, b) => compareStudentsForSort(a, b, sortMode));
                sorted.forEach(student => {
                    const card = studentGrid.querySelector(`[data-student-id="${student.id}"]`);
                    if (card) studentGrid.appendChild(card); // moves the existing node - preserves all its listeners/classes/content untouched
                });
                currentClassMembers = sorted;
            }

            function getLocalDateString(dateObj = new Date()) {
                // en-CA formats as YYYY-MM-DD; anchored to America/Chicago so the "date"
                // matches the school's local day rather than rolling over early via UTC.
                return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(dateObj);
            }

            // --- CLASS DAILY ROLLUPS ---
            // One document per class per day (artifacts/{appId}/public/data/classDailyRollups,
            // id "{classId}_{YYYY-MM-DD}") holding every roster student's totals for that class
            // that day. Class Summary reads these instead of raw feedback documents, so its
            // read cost scales with (distinct classes touched) x (days in range) instead of
            // growing with the entire school year's history every time it's opened.

            function getDatesInRange(startDate, endDate) {
                const dates = [];
                const cursor = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
                const last = new Date(endDate.getFullYear(), endDate.getMonth(), endDate.getDate());
                while (cursor <= last) {
                    dates.push(getLocalDateString(cursor));
                    cursor.setDate(cursor.getDate() + 1);
                }
                return dates;
            }

            // delta fields are all optional increments (positive or negative numbers to add).
            // Only negative-point behaviors carry unresolvedNegative/unresolvedCount/negNoteCount -
            // "unresolved" is scoped to negative scores specifically, matching how it's used
            // (flagging students who need a conference over unresolved negative behavior).
            async function applyRollupDelta(classId, dateStr, studentId, studentName, delta) {
                if (!classId || !dateStr || !studentId) return;
                const hasAnyDelta = Object.keys(delta).some(k => delta[k]);
                if (!hasAnyDelta) return; // nothing to write - e.g. a 0-point behavior
                try {
                    const rollupRef = doc(db, `artifacts/${appId}/public/data/classDailyRollups`, `${classId}_${dateStr}`);
                    const studentUpdate = { name: studentName };
                    if (delta.totalPositive) studentUpdate.totalPositive = increment(delta.totalPositive);
                    if (delta.totalNegative) studentUpdate.totalNegative = increment(delta.totalNegative);
                    if (delta.unresolvedNegative) studentUpdate.unresolvedNegative = increment(delta.unresolvedNegative);
                    if (delta.unresolvedCount) studentUpdate.unresolvedCount = increment(delta.unresolvedCount);
                    if (delta.negNoteCount) studentUpdate.negNoteCount = increment(delta.negNoteCount);

                    // A real nested object (not dotted string keys - that shorthand only
                    // works with updateDoc(), not setDoc(merge:true)) so merge:true correctly
                    // deep-merges just this student's sub-map, leaving every other student's
                    // entry in the same rollup doc untouched.
                    await setDoc(rollupRef, {
                        class: classId,
                        date: dateStr,
                        lastUpdated: new Date(),
                        students: { [studentId]: studentUpdate }
                    }, { merge: true });
                } catch (error) {
                    // A rollup hiccup should never block or fail the actual feedback action -
                    // worst case the rollup drifts slightly and Class Summary is briefly a
                    // little off for that one class/day, which self-corrects on the next write.
                    console.error("Error updating class daily rollup:", error);
                }
            }

            function isBirthdayInAlertWindow(birthdateStr) {
                // Highlights from 7 days before a student's birthday through 1 day after it,
                // re-checked against this year, last year, and next year's date so the window
                // still works correctly for birthdays that fall right around New Year's.
                if (!birthdateStr) return false;
                const parts = birthdateStr.split('-');
                if (parts.length !== 3) return false;
                const month = parseInt(parts[1], 10);
                const day = parseInt(parts[2], 10);
                if (!month || !day) return false;

                const todayStr = getLocalDateString();
                const today = new Date(`${todayStr}T00:00:00`);
                const todayYear = parseInt(todayStr.split('-')[0], 10);
                const oneDayMs = 24 * 60 * 60 * 1000;
                const mm = String(month).padStart(2, '0');
                const dd = String(day).padStart(2, '0');

                return [todayYear - 1, todayYear, todayYear + 1].some(year => {
                    const bday = new Date(`${year}-${mm}-${dd}T00:00:00`);
                    const diffDays = (bday.getTime() - today.getTime()) / oneDayMs;
                    return diffDays >= -1 && diffDays <= 7;
                });
            }

            function renderScheduleView() {
                const dayLabels = { 0: 'Sunday', 1: 'Monday', 2: 'Tuesday', 3: 'Wednesday', 4: 'Thursday', 5: 'Friday', 6: 'Saturday' };
                const dayOrder = [1, 2, 3, 4, 5, 6, 0]; // Monday-first, matching a typical school week
                const content = document.getElementById('view-schedule-content');

                const activeClasses = classSchedules.filter(g => !g.archived);
                const scheduledClasses = activeClasses.filter(g => getScheduleDays(g).length > 0);
                const unscheduledClasses = activeClasses.filter(g => getScheduleDays(g).length === 0);

                let html = '';
                dayOrder.forEach(dayNum => {
                    const classesForDay = scheduledClasses
                        .filter(g => getScheduleDays(g).includes(dayNum))
                        .sort((a, b) => (a.schedule.start || '').localeCompare(b.schedule.start || ''));

                    html += `<div style="margin-bottom: 1.25rem;">`;
                    html += `<h3 style="font-size: 1.05rem; font-weight: 700; border-bottom: 1px solid #4f4f8e; padding-bottom: 0.25rem; margin-bottom: 0.5rem;">${dayLabels[dayNum]}</h3>`;
                    if (classesForDay.length === 0) {
                        html += `<p style="color: #bdc3c7; font-size: 0.85rem;">No classes scheduled.</p>`;
                    } else {
                        html += '<ul style="list-style: none; padding-left: 0; margin: 0;">';
                        classesForDay.forEach(g => {
                            html += `<li style="padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.08);">
                                <strong>${g.id}</strong>${g.description ? ` <span style="color: #bdc3c7; font-size: 0.8rem;">— ${g.description}</span>` : ''}<br>
                                <span style="color: #bdc3c7; font-size: 0.85rem;">${formatTime12hr(g.schedule.start)} – ${formatTime12hr(g.schedule.end)}</span>
                            </li>`;
                        });
                        html += '</ul>';
                    }
                    html += `</div>`;
                });

                if (unscheduledClasses.length > 0) {
                    html += `<div style="margin-top: 0.5rem;">`;
                    html += `<h3 style="font-size: 1.05rem; font-weight: 700; color: #bdc3c7; border-bottom: 1px solid #4f4f8e; padding-bottom: 0.25rem; margin-bottom: 0.5rem;">Unscheduled Classes</h3>`;
                    html += `<p style="font-size: 0.85rem; color: #bdc3c7;">${unscheduledClasses.map(g => g.description ? `${g.id} (${g.description})` : g.id).join(', ')}</p>`;
                    html += `</div>`;
                }

                if (scheduledClasses.length === 0 && unscheduledClasses.length === 0) {
                    html = '<p style="color: #bdc3c7;">No classes on file yet.</p>';
                }

                content.innerHTML = html;
            }

            function checkSchedule() {
            if (classSchedules.length === 0) return;
            const now = new Date();
            const dayIndex = dayOverride === 'auto' ? now.getDay() : parseInt(dayOverride, 10);
            const currentTime = now.toLocaleTimeString('en-US', { timeZone: 'America/Chicago', hour12: false });

            const currentClass = classSchedules.find(c => {
                if (c.archived) return false;
                if (!c.schedule || !c.schedule.start || !c.schedule.end) return false;
                const startTime = formatTime(c.schedule.start);
                const endTime = formatTime(c.schedule.end);
                return getScheduleDays(c).includes(dayIndex) && currentTime >= startTime && currentTime < endTime;
            });

            if (currentClass) {
                const endTimeStr = formatTime(currentClass.schedule.end);
                const [h, m, s] = endTimeStr.split(':').map(Number);
                const endDate = new Date();
                endDate.setHours(h, m, s, 0);
                const diff = endDate.getTime() - now.getTime();

                if (diff > 0) {
                    const hours = Math.floor(diff / 3600000);
                    const minutes = Math.floor((diff % 3600000) / 60000);
                    const seconds = Math.floor((diff % 60000) / 1000);
                    countdownTimerElement.textContent = `Dismissal in ${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                } else {
                    countdownTimerElement.textContent = `Class has ended.`;
                }
                
                if (classSelect.value !== currentClass.id && !autoSelectPerformed) {
                    classSelect.value = currentClass.id;
                    loadClass(currentClass.id).then(() => autoSelectPerformed = true);
                }
                return;
            }
            
            autoSelectPerformed = false;
            
            let nextClass = null;
            const upcomingToday = classSchedules
                .filter(c => !c.archived && c.schedule?.start && getScheduleDays(c).includes(dayIndex) && formatTime(c.schedule.start) > currentTime)
                .sort((a, b) => formatTime(a.schedule.start).localeCompare(formatTime(b.schedule.start)));
            
            if (upcomingToday.length > 0) {
                nextClass = upcomingToday[0];
            } else {
                for (let i = 1; i <= 7; i++) {
                    const nextDayIndex = (dayIndex + i) % 7;
                    const upcomingNextDay = classSchedules
                        .filter(c => !c.archived && c.schedule && getScheduleDays(c).includes(nextDayIndex))
                        .sort((a, b) => formatTime(a.schedule.start).localeCompare(formatTime(b.schedule.start)));

                    if (upcomingNextDay.length > 0) {
                        nextClass = upcomingNextDay[0];
                        break;
                    }
                }
            }
            
            if (nextClass) {
                const [h, m, s] = formatTime(nextClass.schedule.start).split(':').map(Number);
                const nextClassDate = new Date();
                nextClassDate.setHours(h, m, s, 0);

                const dayDifference = (nextClass.schedule.day - dayIndex + 7) % 7;
                if (dayDifference > 0) nextClassDate.setDate(now.getDate() + dayDifference);
                if (nextClassDate.getTime() < now.getTime()) nextClassDate.setDate(now.getDate() + (dayDifference > 0 ? dayDifference : 7));

                const diff = nextClassDate.getTime() - now.getTime();
                if (diff > 0) {
                    const totalHours = Math.floor(diff / 3600000);
                    const minutes = Math.floor((diff % 3600000) / 60000);
                    const seconds = Math.floor((diff % 60000) / 1000);
                    countdownTimerElement.textContent = `Next: ${nextClass.id} in ${totalHours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                }
            } else {
                countdownTimerElement.textContent = "No upcoming classes found.";
            }
        }

       async function handleFeedbackClick(e) {
                const button = e.target.closest('.behavior-btn');
                if (!button) return;
                
                const behavior = button.dataset.behavior;
                const points = parseFloat(button.dataset.points);
                const notes = document.getElementById('notes-input').value;
                const lessonObjective = document.getElementById('lesson-objective').value.trim();

                try {
                    await addDoc(collection(db, `artifacts/${appId}/public/data/feedback`), {
                        teacherId: auth.currentUser.uid, class: currentClassId, studentName: currentStudent.name,
                        studentId: currentStudent.id, behavior, points, notes, lessonObjective, timestamp: new Date(),
                        resolved: false
                    });

                    // Absent and Not Absent are pure status markers, not behaviors - they never
                    // affect point totals, class/student rollups, count badges, or the emoji
                    // trail. Rest Break is a real (if neutral) logged event, so it flows
                    // through the normal path below just like Needs Improvement/Prayed For.
                    if (behavior !== 'Absent' && behavior !== 'Not Absent') {
                        const studentSummaryRef = doc(db, `artifacts/${appId}/public/data/students`, currentStudent.id);
                        // No read needed here: increment() is an atomic blind write that creates
                        // the field starting at 0 if it doesn't exist yet, and merge:true creates
                        // the doc itself if it's somehow missing. This removes a getDoc() from the
                        // single most frequent action in the app (every feedback tap).
                        const updateData = { lastUpdated: new Date() };
                        if (points > 0) updateData.totalPositive = increment(points);
                        else if (points < 0) updateData.totalNegative = increment(points);
                        await setDoc(studentSummaryRef, updateData, { merge: true });

                        const classSummaryRef = doc(db, `artifacts/${appId}/public/data/groups`, currentClassId);
                        const classUpdateData = {};
                        if (points > 0) classUpdateData.totalPositive = increment(points);
                        else if (points < 0) classUpdateData.totalNegative = increment(points);
                        if (Object.keys(classUpdateData).length > 0) {
                            await setDoc(classSummaryRef, classUpdateData, { merge: true });
                        }

                        // Class Summary rollup: one small delta write, keyed to today's date.
                        const rollupDelta = {};
                        if (points > 0) rollupDelta.totalPositive = points;
                        else if (points < 0) {
                            rollupDelta.totalNegative = points;
                            rollupDelta.unresolvedNegative = points; // newly logged - always starts unresolved
                            rollupDelta.unresolvedCount = 1;
                            if (notes) rollupDelta.negNoteCount = 1;
                        }
                        applyRollupDelta(currentClassId, getLocalDateString(), currentStudent.id, currentStudent.name, rollupDelta);
                    }

                    studentGrid.querySelector('.last-logged')?.classList.remove('last-logged');
                    const currentCard = studentGrid.querySelector(`[data-student-id="${currentStudent.id}"]`);
                    if (currentCard) {
                        if (behavior === 'Absent') {
                            absentStudentIds.add(currentStudent.id);
                            showPersistentMessage(`Marked ${currentStudent.name} as Absent`);
                            currentCard.classList.add('absent');
                        } else if (behavior === 'Not Absent') {
                            absentStudentIds.delete(currentStudent.id);
                            showPersistentMessage(`Marked ${currentStudent.name} as Not Absent`);
                            currentCard.classList.remove('absent');
                        } else {
                            if (!sessionStats[currentStudent.id]) {
                                sessionStats[currentStudent.id] = { count: 0, score: 0, emojis: [] };
                            }
                            sessionStats[currentStudent.id].count += 1;
                            sessionStats[currentStudent.id].score += points;
                            if (behaviorEmojis[behavior]) {
                                sessionStats[currentStudent.id].emojis.push(behaviorEmojis[behavior]);
                            }

                            const scoreEl = currentCard.querySelector(`[data-score-for="${currentStudent.id}"]`);
                            const countEl = currentCard.querySelector(`[data-count-for="${currentStudent.id}"]`);
                            const emojiEl = currentCard.querySelector(`[data-emoji-for="${currentStudent.id}"]`);
                            if (scoreEl) {
                                const sessionScore = sessionStats[currentStudent.id].score;
                                scoreEl.textContent = sessionScore.toFixed(1).replace(/\.0$/, '');
                                scoreEl.classList.toggle('positive', sessionScore >= 0);
                                scoreEl.classList.toggle('negative', sessionScore < 0);
                            }
                            if (countEl) {
                                countEl.textContent = `🔁 ${sessionStats[currentStudent.id].count}`;
                            }
                            if (emojiEl) {
                                emojiEl.textContent = sessionStats[currentStudent.id].emojis.join('');
                            }

                            showPersistentMessage(`Logged "${behavior}" for ${currentStudent.name}`);
                            currentCard.classList.add('last-logged');
                        }
                    }
                } catch (error) {
                    console.error("Error writing document: ", error);
                    showPersistentMessage("Failed to save feedback.");
                } finally {
                    feedbackModal.classList.add('hidden');
                    document.getElementById('notes-input').value = '';
                    searchBar.value = '';
                    filterStudents();
                }
            }
            
            // --- CLASS SUMMARY (rollup-based aggregate + unresolved drill-down) ---
            let cachedRollupSummary = null; // Map studentId -> { name, totalPositive, totalNegative, unresolvedNegative, unresolvedCount, negNoteCount }
            let cachedSummaryStudentSearch = ''; // remembers which search produced the cache, for the "no results" message
            let openDrilldownStudentIds = new Set(); // every student whose "View Details" is currently expanded (not just one)
            let drilldownEntriesByStudent = new Map(); // studentId -> that student's logged entries in the selected date range

            async function generateSummary() {
                const summaryContent = document.getElementById('summary-content');
                const summaryClassStats = document.getElementById('summary-class-stats');
                summaryContent.innerHTML = '<p>Loading summary...</p>';
                summaryClassStats.innerHTML = '';
                openDrilldownStudentIds = new Set();
                drilldownEntriesByStudent = new Map();

                const classId = document.getElementById('class-select-summary').value;
                const studentSearchRaw = document.getElementById('student-id-summary').value.trim();

                if (!classId && !studentSearchRaw) {
                    summaryContent.innerHTML = '<p>Please select a class or enter a student name or ID.</p>';
                    return;
                }

                const startDateStr = document.getElementById('start-date').value;
                const endDateStr = document.getElementById('end-date').value;
                const [startYear, startMonth, startDay] = startDateStr.split('-').map(Number);
                const startDate = new Date(startYear, startMonth - 1, startDay, 0, 0, 0, 0);
                const [endYear, endMonth, endDay] = endDateStr.split('-').map(Number);
                const endDate = new Date(endYear, endMonth - 1, endDay, 23, 59, 59, 999);

                try {
                    // Figure out the roster (studentId -> name) for this view.
                    let roster = new Map();
                    let studentIdSearch = '';
                    let searchedStudentGroups = null; // only populated for the single-student-search path

                    if (studentSearchRaw) {
                        const resolved = await resolveStudentIdFromInput(studentSearchRaw);
                        if (resolved.error) {
                            summaryContent.innerHTML = `<p>${resolved.error}</p>`;
                            return;
                        }
                        studentIdSearch = studentSearchRaw;
                        const studentSnap = await getDoc(doc(db, `artifacts/${appId}/public/data/students`, resolved.id));
                        const name = studentSnap.exists() ? (studentSnap.data().name || resolved.id) : resolved.id;
                        roster.set(resolved.id, name);
                        searchedStudentGroups = studentSnap.exists() ? (studentSnap.data().groups || []) : (classId ? [classId] : []);
                    } else {
                        const group = classSchedules.find(g => g.id === classId);
                        (group?.members || []).forEach(m => roster.set(m.id, m.name));
                    }

                    if (roster.size === 0) {
                        summaryContent.innerHTML = '<p>No students found for the selected criteria.</p>';
                        return;
                    }

                    // Determine every distinct class touched by anyone in the roster, using
                    // each member's own denormalized `groups` field (zero extra reads) - or,
                    // for a single searched student, the groups list already fetched above.
                    // Rollup docs are per-class-per-day, so this lets a whole grade's worth of
                    // students share the same handful of document reads instead of paying per
                    // student.
                    const distinctClasses = new Set();
                    if (searchedStudentGroups) {
                        (searchedStudentGroups.length > 0 ? searchedStudentGroups : (classId ? [classId] : [])).forEach(g => distinctClasses.add(g));
                    } else {
                        const group = classSchedules.find(g => g.id === classId);
                        (group?.members || []).forEach(m => {
                            (m.groups && m.groups.length > 0 ? m.groups : [classId]).forEach(g => distinctClasses.add(g));
                        });
                    }

                    const dateStrings = getDatesInRange(startDate, endDate);

                    // One read per (class, day) pair actually touched - missing rollup docs
                    // (no school that day / no activity logged) simply resolve to null.
                    const rollupPromises = [];
                    distinctClasses.forEach(cId => {
                        dateStrings.forEach(dStr => {
                            rollupPromises.push(
                                getDoc(doc(db, `artifacts/${appId}/public/data/classDailyRollups`, `${cId}_${dStr}`))
                                    .then(snap => snap.exists() ? snap.data() : null)
                                    .catch(() => null)
                            );
                        });
                    });
                    const rollupDocs = await Promise.all(rollupPromises);

                    const aggregate = new Map();
                    roster.forEach((name, id) => {
                        aggregate.set(id, { name, totalPositive: 0, totalNegative: 0, unresolvedNegative: 0, unresolvedCount: 0, negNoteCount: 0 });
                    });

                    rollupDocs.forEach(rollup => {
                        if (!rollup || !rollup.students) return;
                        Object.keys(rollup.students).forEach(studentId => {
                            if (!aggregate.has(studentId)) return; // not part of the roster being viewed
                            const s = rollup.students[studentId];
                            const a = aggregate.get(studentId);
                            a.totalPositive += s.totalPositive || 0;
                            a.totalNegative += s.totalNegative || 0;
                            a.unresolvedNegative += s.unresolvedNegative || 0;
                            a.unresolvedCount += s.unresolvedCount || 0;
                            a.negNoteCount += s.negNoteCount || 0;
                            if (s.name) a.name = s.name;
                        });
                    });

                    cachedRollupSummary = aggregate;
                    cachedSummaryStudentSearch = studentIdSearch;

                    renderSummaryFromCache();

                } catch (error) {
                    console.error("Error generating summary:", error);
                    summaryContent.innerHTML = `<p style="color: #e74c3c;">Failed to generate summary. See console for details.</p>`;
                }
            }

            // Builds the current filtered/sorted student list from the cache - shared by the
            // on-screen render and the clipboard export so they never drift apart.
            function getFilteredSortedSummaryArray() {
                if (!cachedRollupSummary) return [];

                const negOnly = document.getElementById('negative-filter-checkbox').checked;
                const ratioFilter = document.getElementById('ratio-filter-checkbox').checked;
                const notesFilter = document.getElementById('notes-filter-checkbox').checked;
                const sortMode = document.getElementById('summary-sort-select').value;

                let summaryArray = Array.from(cachedRollupSummary.entries()).map(([studentId, s]) => ({
                    studentId,
                    name: s.name,
                    totalPositive: s.totalPositive,
                    totalNegative: s.totalNegative,
                    totalPoints: s.totalPositive + s.totalNegative,
                    unresolvedNegative: s.unresolvedNegative,
                    unresolvedCount: s.unresolvedCount,
                    negNoteCount: s.negNoteCount
                }));

                if (negOnly) summaryArray = summaryArray.filter(s => s.totalPoints < 0);
                if (notesFilter) summaryArray = summaryArray.filter(s => s.negNoteCount > 0);
                if (ratioFilter) {
                    summaryArray = summaryArray.filter(s => {
                        if (s.totalNegative === 0) return false; // Infinite ratio doesn't meet "< 5"
                        return (s.totalPositive / Math.abs(s.totalNegative)) < 5;
                    });
                }

                summaryArray.sort((a, b) => {
                    switch (sortMode) {
                        case 'score-asc': return a.totalPoints - b.totalPoints;
                        case 'first-asc': return getFirstLastName(a.name).first.localeCompare(getFirstLastName(b.name).first);
                        case 'first-desc': return getFirstLastName(b.name).first.localeCompare(getFirstLastName(a.name).first);
                        case 'last-asc': return getFirstLastName(a.name).last.localeCompare(getFirstLastName(b.name).last);
                        case 'last-desc': return getFirstLastName(b.name).last.localeCompare(getFirstLastName(a.name).last);
                        case 'score-desc':
                        default: return b.totalPoints - a.totalPoints;
                    }
                });
                return summaryArray;
            }

            function getDisplayStudent(studentId) {
                if (!cachedRollupSummary || !cachedRollupSummary.has(studentId)) return null;
                const s = cachedRollupSummary.get(studentId);
                return {
                    studentId,
                    name: s.name,
                    totalPositive: s.totalPositive,
                    totalNegative: s.totalNegative,
                    totalPoints: s.totalPositive + s.totalNegative,
                    unresolvedNegative: s.unresolvedNegative,
                    unresolvedCount: s.unresolvedCount,
                    negNoteCount: s.negNoteCount
                };
            }

            function buildStudentStatsHtml(student) {
                const studentRatio = student.totalNegative !== 0 ? (student.totalPositive / Math.abs(student.totalNegative)).toFixed(2) : '∞';
                const resolvedNegative = student.totalNegative - student.unresolvedNegative;
                return `
                    <h3 style="font-size: 1.25rem; font-weight: 600;">${student.name} - <span class="${student.totalPoints >= 0 ? 'positive' : 'negative'}">${student.totalPoints.toFixed(1)}</span></h3>
                    <p style="font-size: 0.8rem; color: #bdc3c7;">
                        (<span class="positive">+${student.totalPositive.toFixed(1)}</span> / <span class="negative">${student.totalNegative.toFixed(1)}</span>) (Ratio: ${studentRatio})
                    </p>
                    ${student.unresolvedCount > 0
                        ? `<p style="font-size: 0.8rem; color: #f2c879; font-weight: 600; margin-top: 0.25rem;">⚠ ${student.unresolvedCount} unresolved (${resolvedNegative.toFixed(1)} resolved / ${student.unresolvedNegative.toFixed(1)} unresolved)</p>`
                        : `<p style="font-size: 0.8rem; color: #2ecc71; margin-top: 0.25rem;">✅ Nothing unresolved</p>`
                    }`;
            }

            function renderSummaryFromCache() {
                const summaryContent = document.getElementById('summary-content');
                const summaryClassStats = document.getElementById('summary-class-stats');

                if (!cachedRollupSummary) {
                    return; // nothing fetched yet this modal session
                }

                const studentIdSearch = cachedSummaryStudentSearch;
                const summaryArray = getFilteredSortedSummaryArray();

                let classTotalPositive = 0, classTotalNegative = 0;
                summaryArray.forEach(s => { classTotalPositive += s.totalPositive; classTotalNegative += s.totalNegative; });
                const classTotalPoints = classTotalPositive + classTotalNegative;
                const classRatio = classTotalNegative !== 0 ? (classTotalPositive / Math.abs(classTotalNegative)).toFixed(2) : '∞';
                summaryClassStats.innerHTML = `
                    Overall Score (All Classes): <span class="${classTotalPoints >= 0 ? 'positive' : 'negative'}">${classTotalPoints.toFixed(1)}</span>
                    (<span class="positive">+${classTotalPositive.toFixed(1)}</span> / <span class="negative">${classTotalNegative.toFixed(1)}</span>)
                    (Ratio: ${classRatio})
                `;

                if (summaryArray.length === 0) {
                    summaryContent.innerHTML = studentIdSearch
                        ? `<p>No feedback data found for "${studentIdSearch}" in the selected criteria.</p>`
                        : '<p>No feedback data found for the selected criteria.</p>';
                    return;
                }

                let html = '<div>';
                summaryArray.forEach(student => {
                    const isOpen = openDrilldownStudentIds.has(student.studentId);
                    html += `
                        <div style="background-color: #2a2a4e; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap;">
                                <div class="summary-row-stats" data-stats-for="${student.studentId}">
                                    ${buildStudentStatsHtml(student)}
                                </div>
                                <button type="button" class="modal-btn drilldown-toggle-btn" data-student-id="${student.studentId}" style="background-color: #2980b9; font-size: 0.85rem; padding: 0.5rem 0.9rem;">
                                    ${isOpen ? 'Hide Details' : '🔍 View Details'}
                                </button>
                            </div>
                            <div id="drilldown-${student.studentId}" class="drilldown-container ${isOpen ? '' : 'hidden'}"></div>
                        </div>`;
                });
                html += '</div>';
                summaryContent.innerHTML = html;

                // Re-render every drill-down that was already open - each one's fetched data
                // (drilldownEntriesByStudent) survives this aggregate redraw, and each stays
                // open independently of the others.
                openDrilldownStudentIds.forEach(id => renderDrilldown(id));
            }

            async function toggleStudentDrilldown(studentId) {
                if (openDrilldownStudentIds.has(studentId)) {
                    openDrilldownStudentIds.delete(studentId);
                    drilldownEntriesByStudent.delete(studentId);
                    renderSummaryFromCache();
                    return;
                }

                openDrilldownStudentIds.add(studentId);
                renderSummaryFromCache(); // flips this button's label and shows an (empty) container immediately - every other open student's details are untouched

                const container = document.getElementById(`drilldown-${studentId}`);
                if (container) container.innerHTML = '<p style="color: #bdc3c7; font-size: 0.85rem;">Loading details...</p>';

                try {
                    const startDateStr = document.getElementById('start-date').value;
                    const endDateStr = document.getElementById('end-date').value;
                    const [sy, sm, sd] = startDateStr.split('-').map(Number);
                    const startDate = new Date(sy, sm - 1, sd, 0, 0, 0, 0);
                    const [ey, em, ed] = endDateStr.split('-').map(Number);
                    const endDate = new Date(ey, em - 1, ed, 23, 59, 59, 999);

                    // A single equality filter on studentId - the date range is applied
                    // client-side (avoids needing a composite index). This is still a small,
                    // deliberate, single-student read - not a whole-roster one.
                    const q = query(
                        collection(db, `artifacts/${appId}/public/data/feedback`),
                        where('studentId', '==', studentId)
                    );
                    const snap = await getDocs(q);
                    const entries = snap.docs
                        .map(d => ({ ...d.data(), docId: d.id }))
                        .filter(e => e.timestamp.toDate() >= startDate && e.timestamp.toDate() <= endDate)
                        .sort((a, b) => b.timestamp.toDate() - a.timestamp.toDate());
                    drilldownEntriesByStudent.set(studentId, entries);

                    renderDrilldown(studentId);
                } catch (error) {
                    console.error("Error loading student details:", error);
                    const c = document.getElementById(`drilldown-${studentId}`);
                    if (c) c.innerHTML = '<p style="color: #e74c3c; font-size: 0.85rem;">Failed to load details. See console for details.</p>';
                }
            }

            function renderDrilldown(studentId) {
                const container = document.getElementById(`drilldown-${studentId}`);
                if (!container) return;

                const entries = drilldownEntriesByStudent.get(studentId) || [];

                if (entries.length === 0) {
                    container.innerHTML = '<p style="color: #bdc3c7; font-size: 0.85rem; margin-top: 0.5rem;">No logged behaviors in this range.</p>';
                    return;
                }

                let html = '<ul style="list-style: none; padding-left: 0; margin-top: 0.5rem;">';
                entries.forEach(entry => {
                    const editPayload = encodeURIComponent(JSON.stringify({
                        studentId: entry.studentId || '',
                        class: entry.class || '',
                        behavior: entry.behavior,
                        points: entry.points,
                        notes: entry.notes || '',
                        lessonObjective: entry.lessonObjective || ''
                    }));
                    html += `
                        <li class="${entry.resolved ? 'resolved-entry' : ''}" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; border-left: 2px solid #4f4f8e; padding-left: 0.75rem;">
                            <div>
                                <span class="${entry.points >= 0 ? 'positive' : 'negative'}">${entry.points}</span>: <strong>${entry.behavior}</strong>
                                <span style="font-size: 0.8rem; color: #bdc3c7; margin-left: 0.5rem;">${entry.class || 'Unknown Class'} &bull; ${entry.timestamp.toDate().toLocaleString()}</span>
                                ${entry.resolved ? `<span class="resolved-badge">✅ Resolved</span>` : ''}
                                ${entry.lessonObjective ? `<p style="font-size: 0.75rem; color: #7f9fbf; margin-top: 0.25rem;">Objective: ${entry.lessonObjective}</p>` : ''}
                                ${entry.notes ? `<p style="font-style: italic; color: #bdc3c7; margin-top: 0.25rem;">"${entry.notes}"</p>` : ''}
                                ${entry.resolutionNotes ? `<p style="font-size: 0.8rem; color: #2ecc71; margin-top: 0.25rem;">✅ Resolution: "${entry.resolutionNotes}"</p>` : ''}
                            </div>
                            <div style="display: flex; align-items: center; flex-shrink: 0;">
                                <button class="edit-feedback-btn" data-doc-id="${entry.docId}" data-entry="${editPayload}" title="Edit quality, notes, and objective">✏️</button>
                                ${(entry.points < 0 && !entry.resolved) ? `<button class="resolve-feedback-btn" data-doc-id="${entry.docId}" title="Mark resolved">✓</button>` : ''}
                                <button class="delete-feedback-btn" data-doc-id="${entry.docId}" title="Delete this entry">&times;</button>
                            </div>
                        </li>`;
                });
                html += '</ul>';
                container.innerHTML = html;
            }

            // Finds a cached entry across every currently-open student's details list, and
            // returns which student it belongs to alongside it.
            function findDrilldownEntry(docId) {
                for (const [studentId, entries] of drilldownEntriesByStudent.entries()) {
                    const found = entries.find(e => e.docId === docId);
                    if (found) return { studentId, entry: found };
                }
                return null;
            }

            function applyLocalRollupPatch(studentId, delta) {
                if (!cachedRollupSummary || !cachedRollupSummary.has(studentId)) return;
                const a = cachedRollupSummary.get(studentId);
                if (delta.totalPositive) a.totalPositive += delta.totalPositive;
                if (delta.totalNegative) a.totalNegative += delta.totalNegative;
                if (delta.unresolvedNegative) a.unresolvedNegative += delta.unresolvedNegative;
                if (delta.unresolvedCount) a.unresolvedCount += delta.unresolvedCount;
                if (delta.negNoteCount) a.negNoteCount += delta.negNoteCount;
            }

            async function deleteFeedbackEntry(docId) {
                if (!docId) return;
                const found = findDrilldownEntry(docId);
                const entry = found ? found.entry : null;
                try {
                    await deleteDoc(doc(db, `artifacts/${appId}/public/data/feedback`, docId));
                    showPersistentMessage("Feedback entry deleted.");

                    if (entry) {
                        const delta = {};
                        if (entry.points > 0) {
                            delta.totalPositive = -entry.points;
                        } else if (entry.points < 0) {
                            delta.totalNegative = -entry.points;
                            if (!entry.resolved) {
                                delta.unresolvedNegative = -entry.points;
                                delta.unresolvedCount = -1;
                            }
                            if (entry.notes) delta.negNoteCount = -1;
                        }
                        applyRollupDelta(entry.class, getLocalDateString(entry.timestamp.toDate()), entry.studentId, entry.studentName, delta);
                        applyLocalRollupPatch(entry.studentId, delta);
                        const list = drilldownEntriesByStudent.get(found.studentId);
                        if (list) drilldownEntriesByStudent.set(found.studentId, list.filter(d => d.docId !== docId));
                    }

                    // A delete can change point totals, which can affect active filters
                    // (Neg Only / Ratio < 5) and sort order, so the full list is rebuilt -
                    // every currently-open student's details stay open through the rebuild.
                    renderSummaryFromCache();
                } catch (error) {
                    console.error("Error deleting feedback:", error);
                    showPersistentMessage("Could not delete the feedback entry.");
                }
            }

            function openResolveModal(docId) {
                document.getElementById('resolve-modal').dataset.docId = docId;
                document.getElementById('resolve-notes-input').value = '';
                resolveModal.classList.remove('hidden');
            }

            async function saveResolution() {
                const docId = document.getElementById('resolve-modal').dataset.docId;
                if (!docId) return;
                const notes = document.getElementById('resolve-notes-input').value.trim();
                const found = findDrilldownEntry(docId);
                const entry = found ? found.entry : null;
                try {
                    const resolvedAt = new Date();
                    await updateDoc(doc(db, `artifacts/${appId}/public/data/feedback`, docId), {
                        resolved: true,
                        resolutionNotes: notes,
                        resolvedAt: resolvedAt
                    });
                    showPersistentMessage("Marked resolved.");
                    resolveModal.classList.add('hidden');

                    if (entry) {
                        // Moves this entry's points from the unresolved bucket to the resolved
                        // one - totalNegative (and therefore totalPoints, sort order, and every
                        // active filter's outcome) doesn't change, only which bucket it's
                        // counted in. So there's no need to rebuild the whole list here - just
                        // patch this one student's stats line and this one open details list.
                        const delta = {
                            unresolvedNegative: -entry.points,
                            unresolvedCount: -1
                        };
                        applyRollupDelta(entry.class, getLocalDateString(entry.timestamp.toDate()), entry.studentId, entry.studentName, delta);
                        applyLocalRollupPatch(entry.studentId, delta);
                        entry.resolved = true;
                        entry.resolutionNotes = notes;
                        entry.resolvedAt = resolvedAt;

                        const statsEl = document.querySelector(`[data-stats-for="${entry.studentId}"]`);
                        const displayStudent = getDisplayStudent(entry.studentId);
                        if (statsEl && displayStudent) statsEl.innerHTML = buildStudentStatsHtml(displayStudent);
                        if (openDrilldownStudentIds.has(entry.studentId)) renderDrilldown(entry.studentId);
                    }
                } catch (error) {
                    console.error("Error saving resolution:", error);
                    showPersistentMessage("Failed to save resolution - check the console for details.");
                }
            }

            function openEditFeedbackModal(docId, entryData) {
                editFeedbackModal.dataset.docId = docId;
                editFeedbackModal.dataset.studentId = entryData.studentId;
                editFeedbackModal.dataset.className = entryData.class;
                editFeedbackModal.dataset.oldPoints = entryData.points;
                document.getElementById('edit-feedback-quality').value = entryData.behavior;
                document.getElementById('edit-feedback-objective').value = entryData.lessonObjective;
                document.getElementById('edit-feedback-notes').value = entryData.notes;
                editFeedbackModal.classList.remove('hidden');
            }

            async function saveEditFeedback() {
                const docId = editFeedbackModal.dataset.docId;
                if (!docId) return;

                const studentId = editFeedbackModal.dataset.studentId;
                const className = editFeedbackModal.dataset.className;
                const oldPoints = parseFloat(editFeedbackModal.dataset.oldPoints) || 0;
                const found = findDrilldownEntry(docId); // for old notes/date/studentName
                const entry = found ? found.entry : null;

                const newBehavior = document.getElementById('edit-feedback-quality').value;
                const newObjective = document.getElementById('edit-feedback-objective').value.trim();
                const newNotes = document.getElementById('edit-feedback-notes').value.trim();
                const newPoints = BEHAVIOR_POINTS[newBehavior] ?? 0;

                try {
                    await updateDoc(doc(db, `artifacts/${appId}/public/data/feedback`, docId), {
                        behavior: newBehavior,
                        points: newPoints,
                        lessonObjective: newObjective,
                        notes: newNotes
                    });

                    // If the quality change affects points, correct the rolled-up totals on
                    // both the student and class docs by exactly the delta - not just the raw
                    // new value - since those totals already include the old contribution.
                    const positiveDelta = (newPoints > 0 ? newPoints : 0) - (oldPoints > 0 ? oldPoints : 0);
                    const negativeDelta = (newPoints < 0 ? newPoints : 0) - (oldPoints < 0 ? oldPoints : 0);

                    if (positiveDelta !== 0 || negativeDelta !== 0) {
                        const totalsUpdate = {};
                        if (positiveDelta !== 0) totalsUpdate.totalPositive = increment(positiveDelta);
                        if (negativeDelta !== 0) totalsUpdate.totalNegative = increment(negativeDelta);

                        if (studentId) {
                            await setDoc(doc(db, `artifacts/${appId}/public/data/students`, studentId), totalsUpdate, { merge: true });
                        }
                        if (className) {
                            // Only adjust the class doc if it still exists - a blind write here
                            // would otherwise resurrect a deleted/renamed class with a
                            // members-less, totals-only ghost document.
                            const classRef = doc(db, `artifacts/${appId}/public/data/groups`, className);
                            const classSnap = await getDoc(classRef);
                            if (classSnap.exists()) {
                                await setDoc(classRef, totalsUpdate, { merge: true });
                            }
                        }
                    }

                    // Class Summary rollup: reverse the old contribution and apply the new
                    // one. Unresolved-bucket adjustments only apply while the entry is
                    // actually still unresolved - editing an already-resolved entry shouldn't
                    // touch the unresolved counts.
                    if (entry) {
                        const oldNotes = entry.notes;
                        const wasUnresolved = !entry.resolved;
                        const dateStr = getLocalDateString(entry.timestamp.toDate());
                        const delta = {};
                        if (oldPoints < 0) {
                            delta.totalNegative = (delta.totalNegative || 0) - oldPoints;
                            if (wasUnresolved) {
                                delta.unresolvedNegative = (delta.unresolvedNegative || 0) - oldPoints;
                                delta.unresolvedCount = (delta.unresolvedCount || 0) - 1;
                            }
                            if (oldNotes) delta.negNoteCount = (delta.negNoteCount || 0) - 1;
                        } else if (oldPoints > 0) {
                            delta.totalPositive = (delta.totalPositive || 0) - oldPoints;
                        }
                        if (newPoints < 0) {
                            delta.totalNegative = (delta.totalNegative || 0) + newPoints;
                            if (wasUnresolved) {
                                delta.unresolvedNegative = (delta.unresolvedNegative || 0) + newPoints;
                                delta.unresolvedCount = (delta.unresolvedCount || 0) + 1;
                            }
                            if (newNotes) delta.negNoteCount = (delta.negNoteCount || 0) + 1;
                        } else if (newPoints > 0) {
                            delta.totalPositive = (delta.totalPositive || 0) + newPoints;
                        }
                        applyRollupDelta(className, dateStr, studentId, entry.studentName, delta);
                        applyLocalRollupPatch(studentId, delta);

                        // Details view shows every logged behavior regardless of its point
                        // value, so the entry always stays - just refresh its values in place.
                        entry.behavior = newBehavior;
                        entry.points = newPoints;
                        entry.lessonObjective = newObjective;
                        entry.notes = newNotes;
                    }

                    showPersistentMessage("Entry updated.");
                    editFeedbackModal.classList.add('hidden');
                    // An edit can change point totals, which can affect active filters and
                    // sort order, so the full list is rebuilt - every currently-open student's
                    // details stay open through the rebuild.
                    renderSummaryFromCache();
                } catch (error) {
                    console.error("Error editing feedback entry:", error);
                    showPersistentMessage("Failed to update entry - check the console for details.");
                }
            }

            function copyTextToClipboard(text) {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    return navigator.clipboard.writeText(text);
                }
                return new Promise((resolve, reject) => {
                    try {
                        const ta = document.createElement('textarea');
                        ta.value = text;
                        ta.style.position = 'fixed';
                        ta.style.left = '-9999px';
                        document.body.appendChild(ta);
                        ta.select();
                        document.execCommand('copy');
                        document.body.removeChild(ta);
                        resolve();
                    } catch (err) {
                        reject(err);
                    }
                });
            }

            // Copies BOTH a formatted HTML version (so pasting into an email/doc keeps the
            // colors/bold/spacing) and a plain-text version (for targets that can't accept
            // rich text) in one clipboard write - the paste target picks whichever it supports.
            function copyRichHtmlToClipboard(html, plainText) {
                if (navigator.clipboard && window.ClipboardItem) {
                    try {
                        const item = new ClipboardItem({
                            'text/html': new Blob([html], { type: 'text/html' }),
                            'text/plain': new Blob([plainText], { type: 'text/plain' })
                        });
                        return navigator.clipboard.write([item]);
                    } catch (err) {
                        // Falls through to the selection-based fallback below.
                    }
                }
                // Fallback for browsers without ClipboardItem support: render the HTML into a
                // hidden element, select its rendered content, and let execCommand('copy')
                // capture it - this still preserves rich formatting on paste.
                return new Promise((resolve, reject) => {
                    try {
                        const container = document.createElement('div');
                        container.innerHTML = html;
                        container.style.position = 'fixed';
                        container.style.left = '-9999px';
                        container.style.top = '0';
                        document.body.appendChild(container);

                        const range = document.createRange();
                        range.selectNodeContents(container);
                        const selection = window.getSelection();
                        selection.removeAllRanges();
                        selection.addRange(range);
                        document.execCommand('copy');
                        selection.removeAllRanges();
                        document.body.removeChild(container);
                        resolve();
                    } catch (err) {
                        reject(err);
                    }
                });
            }

            function buildClassSummaryReportText() {
                if (!cachedRollupSummary) return '';

                const classId = document.getElementById('class-select-summary').value;
                const studentSearch = document.getElementById('student-id-summary').value.trim();
                const startDateStr = document.getElementById('start-date').value;
                const endDateStr = document.getElementById('end-date').value;

                const summaryArray = getFilteredSortedSummaryArray();

                let classTotalPositive = 0, classTotalNegative = 0;
                summaryArray.forEach(s => { classTotalPositive += s.totalPositive; classTotalNegative += s.totalNegative; });
                const classTotalPoints = classTotalPositive + classTotalNegative;
                const classRatio = classTotalNegative !== 0 ? (classTotalPositive / Math.abs(classTotalNegative)).toFixed(2) : '∞';

                const divider = '-'.repeat(50);
                let report = '';
                report += `CLASS SUMMARY REPORT\n${'='.repeat(50)}\n`;
                report += `Class: ${classId || (studentSearch ? `Student search - "${studentSearch}"` : 'N/A')}\n`;
                report += `Date Range: ${startDateStr} to ${endDateStr}\n`;
                report += `Report Generated: ${new Date().toLocaleString()}\n\n`;

                report += `OVERALL SCORE (All Classes)\n${divider}\n`;
                report += `${classTotalPoints.toFixed(1)} (+${classTotalPositive.toFixed(1)} / ${classTotalNegative.toFixed(1)}) (Ratio: ${classRatio})\n\n`;

                report += `STUDENT SCORES\n${divider}\n`;
                if (summaryArray.length === 0) {
                    report += 'No feedback data found for the selected criteria.\n';
                } else {
                    summaryArray.forEach(student => {
                        const studentRatio = student.totalNegative !== 0 ? (student.totalPositive / Math.abs(student.totalNegative)).toFixed(2) : '∞';
                        const resolvedNegative = student.totalNegative - student.unresolvedNegative;
                        report += `${student.name}: ${student.totalPoints.toFixed(1)} (+${student.totalPositive.toFixed(1)} / ${student.totalNegative.toFixed(1)}) (Ratio: ${studentRatio})`;
                        report += student.unresolvedCount > 0
                            ? ` - ${student.unresolvedCount} unresolved (${resolvedNegative.toFixed(1)} resolved / ${student.unresolvedNegative.toFixed(1)} unresolved)`
                            : ` - Nothing unresolved`;
                        report += `\n`;

                        // Include the itemized details for anyone whose "View Details" is open right now
                        if (openDrilldownStudentIds.has(student.studentId)) {
                            const entries = drilldownEntriesByStudent.get(student.studentId) || [];
                            if (entries.length === 0) {
                                report += `    No logged behaviors in this range.\n`;
                            } else {
                                entries.forEach(entry => {
                                    report += `    [${entry.timestamp.toDate().toLocaleString()}] ${entry.class || 'Unknown Class'} - ${entry.behavior} (${entry.points >= 0 ? '+' : ''}${entry.points})`;
                                    if (entry.lessonObjective) report += ` | Objective: ${entry.lessonObjective}`;
                                    if (entry.notes) report += ` | Notes: "${entry.notes}"`;
                                    if (entry.resolved) report += ` | RESOLVED${entry.resolutionNotes ? `: "${entry.resolutionNotes}"` : ''}`;
                                    report += `\n`;
                                });
                            }
                        }
                    });
                }

                return report;
            }

            function escapeHtml(str) {
                return (str || '').replace(/[&<>"']/g, ch => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[ch]));
            }

            // Builds a formatted, email-ready version of the current Class Summary view:
            // colors preserved for emphasis, but on a plain white background with no
            // interactive buttons/checkboxes/boxes - just the report content itself.
            function buildClassSummaryReportHtml() {
                if (!cachedRollupSummary) return '';

                const classId = document.getElementById('class-select-summary').value;
                const studentSearch = document.getElementById('student-id-summary').value.trim();
                const startDateStr = document.getElementById('start-date').value;
                const endDateStr = document.getElementById('end-date').value;

                const summaryArray = getFilteredSortedSummaryArray();

                let classTotalPositive = 0, classTotalNegative = 0;
                summaryArray.forEach(s => { classTotalPositive += s.totalPositive; classTotalNegative += s.totalNegative; });
                const classTotalPoints = classTotalPositive + classTotalNegative;
                const classRatio = classTotalNegative !== 0 ? (classTotalPositive / Math.abs(classTotalNegative)).toFixed(2) : '∞';

                // Colors chosen for readability on a plain white background (an email body),
                // rather than reusing the app's on-screen dark-theme palette verbatim.
                const POS = '#1e8449';
                const NEG = '#c0392b';
                const WARN = '#b9770e';
                const MUTED = '#555555';
                const OBJECTIVE = '#2471a3';

                const font = `font-family: Arial, Helvetica, sans-serif; color: #000000;`;
                let html = `<div style="${font} background-color: #ffffff; padding: 4px 0;">`;
                html += `<h2 style="margin: 0 0 6px 0; font-size: 1.3em;">Class Summary Report</h2>`;
                html += `<p style="margin: 0 0 3px 0;"><strong>Class:</strong> ${escapeHtml(classId || (studentSearch ? `Student search - "${studentSearch}"` : 'N/A'))}</p>`;
                html += `<p style="margin: 0 0 3px 0;"><strong>Date Range:</strong> ${escapeHtml(startDateStr)} to ${escapeHtml(endDateStr)}</p>`;
                html += `<p style="margin: 0 0 14px 0; color: ${MUTED};"><strong>Report Generated:</strong> ${new Date().toLocaleString()}</p>`;

                html += `<p style="margin: 0 0 16px 0; font-size: 1.05em;"><strong>Overall Score (All Classes):</strong> `;
                html += `<span style="color: ${classTotalPoints >= 0 ? POS : NEG}; font-weight: bold;">${classTotalPoints.toFixed(1)}</span> `;
