            // --- STUDENT FEEDBACK SEARCH/MATCH ---
            // The "Student Feedback" box doubles as a dictation target: tapping the mic on
            // the iPhone keyboard while this field is focused uses Apple's built-in dictation
            // (not the Web Speech API), so it works even where getUserMedia is blocked (e.g.
            // inside a Google Sites iframe embed). Typed or dictated text is parsed the same
            // way: first word = student name guess, everything after = behavior notes.

            function levenshteinDistance(a, b) {
                const matrix = Array.from({ length: a.length + 1 }, () => new Array(b.length + 1).fill(0));
                for (let i = 0; i <= a.length; i++) matrix[i][0] = i;
                for (let j = 0; j <= b.length; j++) matrix[0][j] = j;
                for (let i = 1; i <= a.length; i++) {
                    for (let j = 1; j <= b.length; j++) {
                        const cost = a[i - 1] === b[j - 1] ? 0 : 1;
                        matrix[i][j] = Math.min(
                            matrix[i - 1][j] + 1,
                            matrix[i][j - 1] + 1,
                            matrix[i - 1][j - 1] + cost
                        );
                    }
                }
                return matrix[a.length][b.length];
            }

            function nameSimilarity(query, candidate) {
                const q = query.toLowerCase();
                const c = candidate.toLowerCase();
                if (!q || !c) return 0;
                if (q === c) return 1;
                const maxLen = Math.max(q.length, c.length) || 1;
                let score = 1 - (levenshteinDistance(q, c) / maxLen);
                if (c.startsWith(q) || q.startsWith(c)) score += 0.15; // dictation/typos often clip the tail of a name
                return Math.min(score, 1);
            }

            function rankStudentMatches(nameGuess, members) {
                if (!nameGuess) return [];
                return members
                    .map(student => {
                        const firstName = (student.name.split(' ')[0] || '').replace(/[^a-zA-Z']/g, '');
                        return { student, score: nameSimilarity(nameGuess, firstName) };
                    })
                    .sort((a, b) => b.score - a.score)
                    .slice(0, 6);
            }

            function submitFeedbackSearch() {
                const raw = searchBar.value.trim();
                if (!raw) return;
                if (!currentClassId || currentClassMembers.length === 0) {
                    showPersistentMessage("Please select a class first.");
                    return;
                }

                const words = raw.split(/\s+/).filter(Boolean);
                const nameGuess = words[0];
                const notes = words.slice(1).join(' ');
                const candidates = rankStudentMatches(nameGuess, currentClassMembers);

                if (candidates.length === 0) {
                    showPersistentMessage(`No students found matching "${nameGuess}" in this class.`);
                    return;
                }

                // A confident, clear top match skips the picker entirely and goes straight
                // to the feedback modal - the common case when a name is typed/dictated cleanly.
                const top = candidates[0];
                const runnerUp = candidates[1];
                const isConfident = top.score >= 0.75 && (!runnerUp || top.score - runnerUp.score >= 0.15);

                if (isConfident) {
                    selectFeedbackMatch(top.student, notes);
                } else {
                    openFeedbackMatchModal(raw, notes, candidates);
                }
            }

