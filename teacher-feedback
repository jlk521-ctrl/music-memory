<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Feedback</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        /* Core body and container styles */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #1a1a2e;
            color: #ffffff;
            height: 100vh;
            width: 100vw;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }
        .main-container {
            background: linear-gradient(-45deg, #23a6d5, #23d5ab, #ee7752, #e73c7e);
            background-size: 400% 400%;
            animation: gradient 150s ease infinite;
            height: 100%;
            width: 100%;
            display: flex;
            flex-direction: column;
            padding: 2rem;
            box-sizing: border-box;
        }
        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        /* Header styles */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: rgba(26, 26, 46, 0.7);
            padding: 1rem 2rem;
            border-radius: 0.5rem;
            backdrop-filter: blur(10px);
            margin-bottom: 1.5rem;
            gap: 1rem;
        }
        .header-title { font-size: 1.5rem; font-weight: 700; }
        .header-info { text-align: right; }
        .day-override-select {
            background-color: #2a2a4e;
            color: #bdc3c7;
            border: 1px solid #4f4f8e;
            border-radius: 999px;
            padding: 0.2rem 0.6rem;
            font-size: 0.75rem;
            font-family: inherit;
            font-weight: 600;
            margin-bottom: 0.3rem;
            cursor: pointer;
        }

        /* Lesson Objective & Laps bar - sits between the student grid and the footer */
        .objective-bar {
            background-color: rgba(26, 26, 46, 0.7);
            border-radius: 0.5rem;
            backdrop-filter: blur(10px);
            padding: 0.75rem 1.5rem;
            margin-top: 1.5rem;
            text-align: center;
        }
        .header-objective {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-weight: 600;
        }
        .header-objective label { white-space: nowrap; }
        #lesson-objective {
            flex: 1;
            max-width: 320px;
            background: transparent;
            border: none;
            border-bottom: 1px solid #4f4f8e;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 400;
            text-align: center;
            padding: 0.25rem;
            min-width: 0;
        }
        #lesson-objective:focus { outline: none; border-bottom: 1px solid #2ecc71; }
        .header-laps {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.8rem;
            color: #bdc3c7;
            margin-top: 0.4rem;
        }
        .header-laps .lap-sep { font-size: 0.9rem; }
        /* Footer styles */
        .footer-bar {
            background-color: rgba(26, 26, 46, 0.7);
            padding: 1rem 2rem;
            border-radius: 0.5rem;
            backdrop-filter: blur(10px);
            margin-top: 1.5rem;
        }
        .footer-bar label { font-weight: 600; display: block; margin-bottom: 0.4rem; }
        #lesson-misconceptions {
            width: 100%;
            resize: vertical;
        }
        /* Main content grid */
        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 1.5rem;
            overflow-y: auto;
            flex-grow: 1;
            padding-right: 1rem;
        }
        /* Student card styles */
        .student-card {
            background-color: rgba(26, 26, 46, 0.7);
            border-radius: 0.5rem;
            padding: 1.5rem;
            padding-top: 2rem;
            padding-bottom: 2.25rem;
            text-align: center;
            backdrop-filter: blur(10px);
            transition: transform 0.2s, box-shadow 0.2s, border 0.3s, opacity 0.3s;
            cursor: pointer;
            border: 2px solid transparent;
            position: relative;
        }
        .student-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }
        .card-emoji-row {
            position: absolute;
            top: 0.4rem;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            font-size: 0.85rem;
            letter-spacing: 1px;
            line-height: 1.2;
            text-align: center;
            white-space: normal;
            word-break: break-all;
        }
        .student-card.last-logged {
            border: 2px solid #2ecc71;
            box-shadow: 0 0 15px rgba(46, 204, 113, 0.7);
        }
        .student-card.absent {
            border: 2px solid #95a5a6;
            box-shadow: 0 0 15px rgba(149, 165, 166, 0.7);
            opacity: 0.6;
        }
        .student-name { font-size: 1.125rem; font-weight: 600; }
        .card-score {
            position: absolute;
            bottom: 0.5rem;
            left: 0.75rem;
            font-size: 0.8rem;
            font-weight: 700;
        }
        .card-count {
            position: absolute;
            bottom: 0.5rem;
            right: 0.75rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: #bdc3c7;
            display: flex;
            align-items: center;
            gap: 0.2rem;
        }
        .card-id-row {
            position: absolute;
            bottom: 0.5rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }
        .card-id-btn {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            font-size: 0.95rem;
            line-height: 1;
            cursor: pointer;
        }
        .card-about-icons {
            font-size: 0.8rem;
            line-height: 1;
        }
        .card-birthday-badge {
            position: absolute;
            top: 0.4rem;
            right: 0.6rem;
            font-size: 1.1rem;
            line-height: 1;
        }
        .student-card.birthday-soon {
            background-color: rgba(241, 196, 15, 0.2);
            box-shadow: 0 0 14px rgba(241, 196, 15, 0.55);
        }
        @keyframes busRiderBlink {
            0%, 49% {
                box-shadow: 0 0 0 4px #e74c3c, 0 0 18px rgba(231, 76, 60, 0.9);
                border-color: #e74c3c;
            }
            50%, 100% {
                box-shadow: none;
                border-color: transparent;
            }
        }
        .student-card.bus-rider-alarm {
            animation: busRiderBlink 1s steps(1, end) infinite;
        }

        .feedback-match-candidate-btn {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            text-align: left;
            margin-bottom: 0.5rem;
            background-color: #2a2a4e;
            border: 1px solid #4f4f8e;
            border-radius: 0.5rem;
            padding: 0.6rem 1rem;
            color: #ffffff;
            font-size: 1rem;
            cursor: pointer;
        }
        .feedback-match-candidate-btn:hover { background-color: #33335c; }
        .feedback-match-candidate-score {
            color: #bdc3c7;
            font-size: 0.8rem;
            white-space: nowrap;
            margin-left: 0.75rem;
        }

        /* Portrait / mobile: stack the header vertically and shrink chrome across the
           board so more student cards fit on screen at once. */
        @media (orientation: portrait) {
            body { height: auto; min-height: 100vh; }
            .main-container { height: auto; min-height: 100vh; padding: 1rem; }
            .header {
                flex-direction: column;
                align-items: stretch;
                padding: 0.75rem 1rem;
                margin-bottom: 1rem;
            }
            .header-left, .header-info { text-align: center; }
            .objective-bar {
                padding: 0.5rem 0.75rem;
                margin-top: 1rem;
            }
            #lesson-objective { max-width: none; }
            .header-laps { font-size: 0.7rem; gap: 0.3rem; }
            .grid-container {
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
                gap: 0.75rem;
                flex-grow: 0;
                min-height: 68vh;
            }
            .student-card {
                padding: 1rem;
                padding-top: 1.6rem;
                padding-bottom: 1.9rem;
            }
            .student-name { font-size: 1rem; }
            .card-emoji-row { font-size: 0.75rem; top: 0.3rem; }
            .card-score, .card-count { font-size: 0.7rem; bottom: 0.35rem; }
            .card-id-btn { font-size: 0.85rem; }
            .card-about-icons { font-size: 0.7rem; }
            .card-id-row { bottom: 0.35rem; }
        }
        /* Modal styles */
        .modal-backdrop {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding-top: 5vh;
            overflow-y: auto;
            z-index: 1000;
        }
        .modal-content {
            background-color: #1a1a2e;
            padding: 2.5rem;
            border-radius: 0.75rem;
            width: 90%;
            max-width: 500px;
            margin-bottom: 5vh;
        }
        .modal-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
        .behavior-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .behavior-btn {
            padding: 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid #4f4f8e;
            background-color: transparent;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 80px;
        }
        .behavior-descriptor {
            font-size: 0.75rem;
            font-weight: 400;
            color: #bdc3c7;
            margin-top: 0.25rem;
        }
        .behavior-btn.positive:hover { background-color: #27ae60; }
        .behavior-btn.negative:hover { background-color: #c0392b; }
        .behavior-btn.neutral:hover { background-color: #7f8c8d; }
        .behavior-btn.spiritual { border-color: #9b59b6; }
        .behavior-btn.spiritual:hover { background-color: #9b59b6; }
        .behavior-btn.absent-btn {
            flex: 1;
            min-width: 120px;
            background-color: #7f8c8d;
        }
        .behavior-btn.absent-btn:hover {
            background-color: #95a5a6;
        }
        .behavior-btn.not-absent-btn {
            flex: 1;
            min-width: 120px;
            background-color: #2e86c1;
        }
        .behavior-btn.not-absent-btn:hover {
            background-color: #3498db;
        }
        .behavior-btn.rest-break-btn {
            flex: 1;
            min-width: 120px;
            background-color: #48607a;
        }
        .behavior-btn.rest-break-btn:hover {
            background-color: #5a7593;
        }
        .modal-footer { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem; }
        .modal-btn { padding: 0.75rem 1.5rem; border-radius: 0.5rem; border: none; cursor: pointer; color: #ffffff; font-weight: 600; }
        select, textarea, input[type="text"], input[type="date"], input[type="number"] {
            background-color: #2a2a4e;
            color: #ffffff;
            border: 1px solid #4f4f8e;
            border-radius: 0.375rem;
            padding: 0.5rem;
            box-sizing: border-box;
            font-size: 16px;
        }
        .hidden { display: none; }
        .positive { color: #2ecc71; }
        .negative { color: #e74c3c; }
        
        #success-message {
            position: fixed;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #27ae60;
            color: white;
            padding: 1rem 2rem;
            border-radius: 0.5rem;
            transition: top 0.5s ease-in-out;
            z-index: 999;
            text-align: center;
            width: 90%;
            max-width: 500px;
        }
        #success-message.show {
            top: 20px;
        }
        .tab-btn {
            padding: 0.5rem 1rem;
            border-radius: 0.375rem 0.375rem 0 0;
            background-color: #2a2a4e;
            border: 1px solid #4f4f8e;
            border-bottom: none;
            opacity: 0.6;
            color: #ffffff;
            cursor: pointer;
        }
        .tab-btn.active {
            opacity: 1;
            background-color: #1a1a2e;
            border-bottom: 1px solid #1a1a2e;
        }
        .tab-content {
            border: 1px solid #4f4f8e;
            border-top: none;
            padding: 1.5rem;
            border-radius: 0 0 0.375rem 0.375rem;
        }
        .day-checkbox-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 0.4rem;
        }
        .day-checkbox-row label {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.85rem;
            font-weight: 400;
            background-color: #2a2a4e;
            border: 1px solid #4f4f8e;
            border-radius: 0.375rem;
            padding: 0.4rem 0.6rem;
            cursor: pointer;
        }
        .day-checkbox-row input[type="checkbox"] {
            accent-color: #2ecc71;
        }
        .about-me-icon-item {
            margin-top: 0.5rem;
        }
        .about-me-icon-label {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.9rem;
            font-weight: 400;
            cursor: pointer;
        }
        .about-me-icon-label input[type="checkbox"] {
            accent-color: #2ecc71;
        }
        .about-me-icon-note {
            width: 100%;
            margin-top: 0.35rem;
            margin-left: 1.4rem;
            font-size: 0.85rem;
        }
        .icon-legend {
            background-color: rgba(26, 26, 46, 0.5);
            border-radius: 0.5rem;
            padding: 0.5rem 1rem;
            margin-bottom: 1rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem 1rem;
            font-size: 0.78rem;
            color: #bdc3c7;
        }
        .icon-legend span { white-space: nowrap; }
         .delete-feedback-btn {
            background: #c0392b;
            color: white;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 12px;
            line-height: 20px;
            text-align: center;
            cursor: pointer;
            margin-left: 10px;
            transition: background 0.2s;
        }
        .delete-feedback-btn:hover {
            background: #e74c3c;
        }
        .resolve-feedback-btn {
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 11px;
            line-height: 20px;
            text-align: center;
            cursor: pointer;
            margin-left: 8px;
            transition: background 0.2s;
        }
        .resolve-feedback-btn:hover {
            background: #2ecc71;
        }
        .resolve-feedback-btn.is-resolved {
            background: #1e8449;
            box-shadow: 0 0 0 2px rgba(46, 204, 113, 0.5);
        }
        .edit-feedback-btn {
            background: #2980b9;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 10px;
            line-height: 20px;
            text-align: center;
            cursor: pointer;
            margin-left: 8px;
            transition: background 0.2s;
        }
        .edit-feedback-btn:hover {
            background: #3498db;
        }
        .resolved-entry {
            opacity: 0.7;
        }
        .resolved-badge {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            color: #2ecc71;
            background: rgba(46, 204, 113, 0.15);
            border: 1px solid #2ecc71;
            border-radius: 0.75rem;
            padding: 0.1rem 0.5rem;
            margin-left: 0.5rem;
        }
        .drilldown-container {
            margin-top: 0.75rem;
            padding-top: 0.5rem;
            border-top: 1px solid #4f4f8e;
        }
        .drilldown-container.hidden {
            display: none;
        }

    </style>
</head>
<body class="main-container">

    <!-- Header Section -->
    <header class="header">
        <div class="header-left">
            <h1 class="header-title">Teacher Feedback System</h1>
            <p id="current-class" class="text-gray-400">No class selected</p>
        </div>
        <div class="header-info">
            <select id="day-override-select" class="day-override-select" title="Override which day's schedule to follow">
                <option value="auto">Today (Auto)</option>
                <option value="0">Sunday</option>
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
            </select>
            <div id="clock" style="font-size: 1.5rem; font-weight: 700;"></div>
            <p id="countdown-timer" style="color: #bdc3c7;"></p>
            <p id="request-counter-display" title="Firebase reads/writes made from this device today" style="color: #6b7280; font-size: 0.7rem; margin-top: 0.15rem;"></p>
        </div>
    </header>

    <!-- Controls: Class Selector & Search -->
    <div style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
        <div style="flex: 2; min-width: 200px;">
             <label for="class-select" class="font-semibold" style="display: block; margin-bottom: 0.25rem;">Select Class:</label>
             <select id="class-select" style="width: 100%;"></select>
        </div>
        <div style="min-width: 160px;">
             <label for="grid-sort-select" class="font-semibold" style="display: block; margin-bottom: 0.25rem;">Sort By:</label>
             <select id="grid-sort-select" style="width: 100%;">
                 <option value="score-desc">Score (High to Low)</option>
                 <option value="score-asc">Score (Low to High)</option>
                 <option value="first-asc" selected>First Name (A-Z)</option>
                 <option value="first-desc">First Name (Z-A)</option>
                 <option value="last-asc">Last Name (A-Z)</option>
                 <option value="last-desc">Last Name (Z-A)</option>
             </select>
        </div>
        <div style="flex: 1.5; min-width: 200px;">
             <label for="search-bar" class="font-semibold" style="display: block; margin-bottom: 0.25rem;">Student Feedback:</label>
             <div style="display: flex; gap: 0.5rem;">
                 <input type="text" id="search-bar" placeholder="Start typing a name and behavior notes..." style="width: 100%; flex: 1;">
                 <button type="button" id="search-submit-btn" class="modal-btn" style="background-color: #2980b9; padding: 0.5rem 0.9rem;" title="Match to a student">➤</button>
             </div>
        </div>
        <div class="flex gap-2" style="align-self: flex-end;">
             <button id="manage-classes-btn" class="modal-btn" style="background-color: #8e44ad;">Manage Classes</button>
             <button id="view-schedule-btn" class="modal-btn" style="background-color: #34495e;">View Schedule</button>
             <button id="manage-students-btn" class="modal-btn" style="background-color: #e67e22;">Manage Students</button>
             <button id="summary-btn" class="modal-btn" style="background-color: #2980b9;">Class Summary</button>
             <button id="student-report-btn" class="modal-btn" style="background-color: #16a085;">Student Report</button>
        </div>
    </div>

    <!-- Quick Reminder Icon Legend -->
    <div id="icon-legend" class="icon-legend"></div>

    <!-- Student Grid -->
    <main id="student-grid" class="grid-container">
        <p>Please select a class to see the student roster.</p>
    </main>

    <!-- Lesson Objective & Laps Bar -->
    <div class="objective-bar">
        <div class="header-objective">
            <label for="lesson-objective">Lesson Objective:</label>
            <input type="text" id="lesson-objective" list="lesson-objective-options" placeholder="(Fill in the Blank)">
            <datalist id="lesson-objective-options">
                <option value="Cafeteria">
                <option value="Dancing">
                <option value="Entering">
                <option value="Instruments">
                <option value="Morning Duty">
                <option value="Music Appreciation">
                <option value="Rhythm">
                <option value="Singing">
            </datalist>
        </div>
        <div class="header-laps">
            <span>Lap 1: Basic Practical</span><span class="lap-sep">🔁</span>
            <span>Lap 2: Lesson Practical</span><span class="lap-sep">🔁</span>
            <span>Lap 3: Objective Progress</span><span class="lap-sep">🔁</span>
            <span>Lap 4: Objective Mastered</span><span class="lap-sep">🔁</span>
            <span>Lap 5: Class Leaders</span>
        </div>
    </div>

    <!-- Footer Bar -->
    <footer class="footer-bar">
        <label for="lesson-misconceptions">Lesson Trending Misconceptions:</label>
        <textarea id="lesson-misconceptions" rows="2" placeholder="Notes"></textarea>
    </footer>

    <!-- Feedback Modal -->
    <div id="feedback-modal" class="modal-backdrop hidden">
        <div class="modal-content">
            <h2 id="modal-student-name" class="modal-title">Feedback for Student</h2>
            <div class="behavior-grid">
                <button class="behavior-btn positive" data-behavior="Excellent" data-points="2">🔥 Excellent</button>
                <button class="behavior-btn positive" data-behavior="Satisfactory" data-points="1">✅ Satisfactory</button>
                <button class="behavior-btn positive" data-behavior="Slow-to-Start" data-points="0.5">⚠️ Slow-to-Start</button>
                <button class="behavior-btn neutral" data-behavior="Needs Improvement" data-points="0">🆘 Needs Improvement</button>
                <button class="behavior-btn negative" data-behavior="Off-Task" data-points="-2">❌ Off-Task</button>
                <button class="behavior-btn spiritual" data-behavior="Prayed For" data-points="0">🙏 Prayed For</button>
            </div>
            <textarea id="notes-input" placeholder="Add optional notes..." rows="3" style="width: 100%; margin-bottom: 1rem;"></textarea>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;">
                <button class="behavior-btn absent-btn" data-behavior="Absent" data-points="0">Mark as Absent</button>
                <button class="behavior-btn not-absent-btn" data-behavior="Not Absent" data-points="0">Not Absent</button>
                <button class="behavior-btn rest-break-btn" data-behavior="Rest Break" data-points="0">⏸️ Rest Break</button>
            </div>
            <div class="modal-footer">
                <button id="cancel-feedback-btn" class="modal-btn" style="background-color: #7f8c8d;">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Feedback Match Modal -->
    <div id="feedback-match-modal" class="modal-backdrop hidden">
        <div class="modal-content" style="max-width: 500px;">
            <h2 class="modal-title">Confirm Student</h2>
