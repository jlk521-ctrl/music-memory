            function formatBirthdateShort(birthdateStr) {
                if (!birthdateStr) return '';
                const parts = birthdateStr.split('-');
                if (parts.length !== 3) return '';
                const month = parseInt(parts[1], 10);
                const day = parseInt(parts[2], 10);
                if (!month || !day || month < 1 || month > 12) return '';
                const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

                // Figure out which year's occurrence is the upcoming one (matches the same
                // -1/+7 day window used by isBirthdayInAlertWindow) so the weekday is correct.
                const todayStr = getLocalDateString();
                const today = new Date(`${todayStr}T00:00:00`);
                const todayYear = parseInt(todayStr.split('-')[0], 10);
                const oneDayMs = 24 * 60 * 60 * 1000;
                const mm = String(month).padStart(2, '0');
                const dd = String(day).padStart(2, '0');

                let targetYear = todayYear;
                for (const year of [todayYear - 1, todayYear, todayYear + 1]) {
                    const bday = new Date(`${year}-${mm}-${dd}T00:00:00`);
                    const diffDays = (bday.getTime() - today.getTime()) / oneDayMs;
                    if (diffDays >= -1 && diffDays <= 7) {
                        targetYear = year;
                        break;
                    }
                }

                const upcomingBday = new Date(`${targetYear}-${mm}-${dd}T00:00:00`);
                return `${dayNames[upcomingBday.getDay()]} ${monthNames[month - 1]} ${day}`;
            }

