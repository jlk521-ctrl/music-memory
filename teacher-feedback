            async function resolveStudentIdFromInput(rawInput) {
                // Returns { id } on a clean single match, or { error } / { choices } to report back.
                if (/^\d+$/.test(rawInput)) {
                    return { id: rawInput };
                }

                const normalized = rawInput.toLowerCase();

                // Build a deduped id->name index from the class rosters already sitting in
                // memory (classSchedules is populated by populateClassSelect() with zero
                // extra reads), so a name search costs nothing in the common case instead of
                // reading every student document in the school every time someone types a name.
                const candidateMap = new Map();
                classSchedules.forEach(group => {
                    (group.members || []).forEach(m => {
                        if (!candidateMap.has(m.id)) candidateMap.set(m.id, m.name);
                    });
                });

                let exactMatches = [];
                let partialMatches = [];
                candidateMap.forEach((name, id) => {
                    const lower = (name || '').toLowerCase();
                    if (!lower) return;
                    if (lower === normalized) exactMatches.push({ id, name });
                    else if (lower.includes(normalized)) partialMatches.push({ id, name });
                });

                let matches = exactMatches.length > 0 ? exactMatches : partialMatches;

                if (matches.length === 0) {
                    // Nothing in any known roster matched - fall back to a full scan only as
                    // a last resort (e.g. a student not currently enrolled in any class), so
                    // the expensive path only ever runs when it's actually needed.
                    const studentsSnapshot = await getDocs(collection(db, `artifacts/${appId}/public/data/students`));
                    studentsSnapshot.forEach(d => {
                        const name = (d.data().name || '').toLowerCase();
                        if (!name) return;
                        if (name === normalized) exactMatches.push({ id: d.id, name: d.data().name });
                        else if (name.includes(normalized)) partialMatches.push({ id: d.id, name: d.data().name });
                    });
                    matches = exactMatches.length > 0 ? exactMatches : partialMatches;
                }

                if (matches.length === 0) {
                    return { error: `No student found matching "${rawInput}".` };
                }
                if (matches.length > 1) {
                    const list = matches.slice(0, 10).map(m => `${m.name} (ID: ${m.id})`).join(', ');
                    const more = matches.length > 10 ? `, and ${matches.length - 10} more` : '';
                    return { error: `Multiple students match "${rawInput}": ${list}${more}. Please enter the exact Student ID instead.` };
                }
                return { id: matches[0].id };
            }

            async function generateStudentReport() {
                const rawInput = document.getElementById('student-report-id').value.trim();
                const emptyMsg = document.getElementById('student-report-empty');
                const outputWrapper = document.getElementById('student-report-output-wrapper');
                const output = document.getElementById('student-report-output');

                if (!rawInput) {
                    showPersistentMessage("Please enter a Student ID or name.");
                    return;
                }

                outputWrapper.classList.add('hidden');
                emptyMsg.textContent = "Loading report...";
                emptyMsg.classList.remove('hidden');

                try {
                    const resolved = await resolveStudentIdFromInput(rawInput);
                    if (resolved.error) {
                        emptyMsg.textContent = resolved.error;
                        return;
                    }
                    const studentId = resolved.id;

                    const studentSnap = await getDoc(doc(db, `artifacts/${appId}/public/data/students`, studentId));
                    const studentName = studentSnap.exists() ? (studentSnap.data().name || studentId) : studentId;
                    const studentGroups = studentSnap.exists() ? (studentSnap.data().groups || []) : [];
                    const aboutMe = studentSnap.exists() ? (studentSnap.data().aboutMe || {}) : {};

                    const feedbackQuery = query(collection(db, `artifacts/${appId}/public/data/feedback`), where("studentId", "==", studentId));
                    const feedbackSnapshot = await getDocs(feedbackQuery);

                    if (!studentSnap.exists() && feedbackSnapshot.empty) {
                        emptyMsg.textContent = `No record found for Student ID ${studentId}.`;
                        return;
                    }

                    const entries = feedbackSnapshot.docs
                        .map(d => d.data())
                        .filter(entry => entry.behavior !== 'Prayed For') // kept private - not for administrative reports
                        .sort((a, b) => a.timestamp.toDate() - b.timestamp.toDate());

                    let totalPositive = 0, totalNegative = 0, loggedEntries = 0, absentCount = 0;
                    const behaviorTally = {};

                    entries.forEach(entry => {
                        if (entry.behavior === 'Absent') {
                            absentCount++;
                            return;
                        }
                        loggedEntries++;
                        if (entry.points > 0) totalPositive += entry.points;
                        if (entry.points < 0) totalNegative += entry.points;
                        if (!behaviorTally[entry.behavior]) behaviorTally[entry.behavior] = { count: 0, points: 0 };
                        behaviorTally[entry.behavior].count++;
                        behaviorTally[entry.behavior].points += entry.points;
                    });

                    const totalScore = totalPositive + totalNegative;
                    const ratio = totalNegative !== 0 ? (totalPositive / Math.abs(totalNegative)).toFixed(2) : '∞';
                    const firstDate = entries.length > 0 ? entries[0].timestamp.toDate() : null;
                    const lastDate = entries.length > 0 ? entries[entries.length - 1].timestamp.toDate() : null;

                    const divider = '-'.repeat(50);
                    let report = '';
                    report += `STUDENT BEHAVIOR REPORT\n`;
                    report += `${'='.repeat(50)}\n`;
                    report += `Student: ${studentName} (ID: ${studentId})\n`;
                    report += `Report Generated: ${new Date().toLocaleString()}\n`;
                    report += `Classes on Record: ${studentGroups.length > 0 ? studentGroups.join(', ') : 'None on file'}\n`;
                    report += `Date Range Covered: ${firstDate ? firstDate.toLocaleDateString() : 'N/A'} to ${lastDate ? lastDate.toLocaleDateString() : 'N/A'}\n\n`;

                    const iconLabels = ABOUT_ME_ICON_OPTIONS.reduce((map, opt) => { map[opt.emoji] = opt.label; return map; }, {});
                    const iconNotes = aboutMe.iconNotes || {};
                    report += `ABOUT ME\n${divider}\n`;
                    report += `Birthdate: ${aboutMe.birthdate || 'N/A'}\n`;
                    report += `Gender: ${aboutMe.gender || 'N/A'}\n`;
                    report += `Parent/Guardian Contact: ${aboutMe.parentContact || 'N/A'}\n`;
                    report += `Teacher Notes: ${aboutMe.teacherNotes || 'N/A'}\n`;
                    if (aboutMe.icons && aboutMe.icons.length > 0) {
                        report += `Quick Reminders:\n`;
                        aboutMe.icons.forEach(e => {
                            const note = iconNotes[e];
                            report += `  - ${e} ${iconLabels[e] || ''}${note ? `: ${note}` : ''}\n`;
                        });
                        report += `\n`;
                    } else {
                        report += `Quick Reminders: None\n\n`;
                    }

                    report += `SUMMARY\n${divider}\n`;
                    report += `Total Feedback Entries Logged: ${loggedEntries} (excludes ${absentCount} absence${absentCount === 1 ? '' : 's'})\n`;
                    report += `Total Score: ${totalScore.toFixed(1)} (+${totalPositive.toFixed(1)} / ${totalNegative.toFixed(1)})\n`;
                    report += `Positive-to-Negative Ratio: ${ratio}\n\n`;

                    report += `BEHAVIOR BREAKDOWN\n${divider}\n`;
                    Object.keys(reportBehaviorEmojis).forEach(behavior => {
                        const emoji = reportBehaviorEmojis[behavior];
                        const tally = behaviorTally[behavior];
                        if (tally) {
                            report += `${emoji} ${behavior}: ${tally.count} time(s), ${tally.points >= 0 ? '+' : ''}${tally.points.toFixed(1)} pts\n`;
                        } else {
                            report += `${emoji} ${behavior}: 0 times\n`;
                        }
                    });
                    report += `Absences: ${absentCount}\n\n`;

                    report += `DETAILED LOG (most recent first)\n${divider}\n`;
                    if (entries.length === 0) {
                        report += `No feedback has been logged for this student yet.\n`;
                    } else {
                        [...entries].reverse().forEach(entry => {
                            const dateStr = entry.timestamp.toDate().toLocaleString();
                            const emoji = reportBehaviorEmojis[entry.behavior] || '';
                            report += `[${dateStr}] ${entry.class || 'Unknown Class'} - ${emoji} ${entry.behavior}`;
                            if (entry.lessonObjective) report += ` | Objective: ${entry.lessonObjective}`;
                            if (entry.notes) report += ` | Notes: "${entry.notes}"`;
                            if (entry.resolved) report += ` | ✅ RESOLVED${entry.resolutionNotes ? `: "${entry.resolutionNotes}"` : ''}`;
                            report += `\n`;
                        });
                    }

                    output.value = report;
                    emptyMsg.classList.add('hidden');
                    outputWrapper.classList.remove('hidden');

                } catch (error) {
                    console.error("Error generating student report:", error);
                    emptyMsg.textContent = "Failed to generate report. See console for details.";
                    emptyMsg.classList.remove('hidden');
                }
            }


