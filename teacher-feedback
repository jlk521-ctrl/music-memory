                        const docId = e.target.dataset.docId;
                        const entryData = JSON.parse(decodeURIComponent(e.target.dataset.entry));
                        openEditFeedbackModal(docId, entryData);
                    }
                    if (e.target.classList.contains('drilldown-toggle-btn')) {
                        const studentId = e.target.dataset.studentId;
                        toggleStudentDrilldown(studentId);
                    }
                });

                document.getElementById('manage-classes-btn').addEventListener('click', () => {
                    document.getElementById('add-class-form').reset();
                    document.getElementById('delete-class-form').reset();
                    document.getElementById('delete-class-submit').disabled = true;
                    document.getElementById('edit-class-form').reset();
                    document.getElementById('bulk-import-data').value = '';
                    document.getElementById('bulk-import-summary').classList.add('hidden');
                    document.getElementById('bulk-import-confirm-btn').classList.add('hidden');
                    bulkImportPlan = null;
                    populateManageClassesSelects();
                    manageClassesModal.classList.remove('hidden');
                });
                document.getElementById('close-manage-classes-btn').addEventListener('click', () => {
                    manageClassesModal.classList.add('hidden');
                });
                document.getElementById('add-class-form').addEventListener('submit', createNewClass);
                document.getElementById('delete-class-form').addEventListener('submit', deleteClass);
                document.getElementById('archive-class-form').addEventListener('submit', archiveClass);
                document.getElementById('unarchive-class-form').addEventListener('submit', unarchiveClass);
                document.getElementById('edit-class-form').addEventListener('submit', editClass);
                document.getElementById('edit-class-select').addEventListener('change', (e) => {
                    applyEditFieldsForClass(e.target.value);
                });
                document.getElementById('bulk-import-preview-btn').addEventListener('click', previewBulkImport);
                document.getElementById('bulk-import-confirm-btn').addEventListener('click', confirmBulkImport);

                manageClassesModal.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        manageClassesModal.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        manageClassesModal.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
                        document.getElementById(`${btn.dataset.tab}-class-tab`).classList.remove('hidden');
                    });
                });

                const deleteClassSelect = document.getElementById('delete-class-select');
                const deleteClassConfirm = document.getElementById('delete-class-confirm');
                const deleteClassSubmit = document.getElementById('delete-class-submit');
                function checkDeleteClassForm() {
                    const selected = deleteClassSelect.value;
                    const confirmVal = deleteClassConfirm.value.trim();
                    deleteClassSubmit.disabled = !(selected && selected === confirmVal);
                }
                [deleteClassSelect, deleteClassConfirm].forEach(el => el.addEventListener('input', checkDeleteClassForm));
                [deleteClassSelect, deleteClassConfirm].forEach(el => el.addEventListener('change', checkDeleteClassForm));

                document.getElementById('manage-students-btn').addEventListener('click', openStudentManagementModal);
                document.getElementById('close-manage-students-btn').addEventListener('click', () => studentManagementModal.classList.add('hidden'));
                 studentManagementModal.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        studentManagementModal.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        studentManagementModal.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
                        document.getElementById(`${btn.dataset.tab}-student-tab`).classList.remove('hidden');
                    });
                });

                // --- Student Management Form Listeners ---
                document.getElementById('add-student-form').addEventListener('submit', addStudent);
                document.getElementById('bulk-add-student-form').addEventListener('submit', bulkAddStudents);
                document.getElementById('edit-student-form').addEventListener('submit', editStudent);
                document.getElementById('remove-student-form').addEventListener('submit', removeStudent);

                // Add confirmation input listeners
                const addStudentName = document.getElementById('add-student-name');
                const addStudentConfirm = document.getElementById('add-student-confirm');
                const addStudentSubmit = document.getElementById('add-student-submit');
                const addStudentIdInput = document.getElementById('add-student-id');

                function checkAddStudentForm() {
                    const name = addStudentName.value.trim();
                    const confirm = addStudentConfirm.value.trim();
                    const id = addStudentIdInput.value.trim();
                    addStudentSubmit.disabled = !(name && name === confirm && /^\d{6}$/.test(id));
                }
                [addStudentName, addStudentConfirm, addStudentIdInput].forEach(el => el.addEventListener('input', checkAddStudentForm));

                const editStudentSelect = document.getElementById('edit-student-select');
                const editStudentNewName = document.getElementById('edit-student-new-name');
                const editStudentConfirm = document.getElementById('edit-student-confirm');
                const editStudentSubmit = document.getElementById('edit-student-submit');
                const editStudentAboutMeBtn = document.getElementById('edit-student-about-me-btn');

                function checkEditStudentForm() {
                    const newName = editStudentNewName.value.trim();
                    const confirm = editStudentConfirm.value.trim();
                    const selected = editStudentSelect.value;
                    editStudentSubmit.disabled = !(newName && newName === confirm && selected);
                    editStudentAboutMeBtn.disabled = !selected;
                }
                [editStudentSelect, editStudentNewName, editStudentConfirm].forEach(el => el.addEventListener('input', checkEditStudentForm));
                [editStudentSelect, editStudentNewName, editStudentConfirm].forEach(el => el.addEventListener('change', checkEditStudentForm));
                editStudentAboutMeBtn.addEventListener('click', () => {
                    const selectedOption = editStudentSelect.options[editStudentSelect.selectedIndex];
                    if (!editStudentSelect.value || !selectedOption) return;
                    openAboutMeModal(editStudentSelect.value, selectedOption.dataset.name || selectedOption.textContent);
                });
                document.getElementById('close-about-me-btn').addEventListener('click', () => {
                    aboutMeModal.classList.add('hidden');
                });
                document.getElementById('about-me-form').addEventListener('submit', saveAboutMe);
                document.getElementById('about-me-add-class-btn').addEventListener('click', () => {
                    const studentId = document.getElementById('about-me-form').dataset.studentId;
                    const studentName = document.getElementById('about-me-form').dataset.studentName;
                    const classId = document.getElementById('about-me-add-class-select').value;
                    if (!studentId) return;
                    addStudentToClassAboutMe(studentId, studentName, classId);
                });

                const removeStudentSelect = document.getElementById('remove-student-select');
                const removeStudentConfirm = document.getElementById('remove-student-confirm');
                const removeStudentSubmit = document.getElementById('remove-student-submit');

                function checkRemoveStudentForm() {
                    const selectedOption = removeStudentSelect.options[removeStudentSelect.selectedIndex];
                    const studentName = selectedOption ? selectedOption.dataset.name : '';
                    const confirm = removeStudentConfirm.value.trim();
                    const selected = removeStudentSelect.value;
                    removeStudentSubmit.disabled = !(selected && studentName && studentName === confirm);
                }
                [removeStudentSelect, removeStudentConfirm].forEach(el => el.addEventListener('input', checkRemoveStudentForm));
                [removeStudentSelect, removeStudentConfirm].forEach(el => el.addEventListener('change', checkRemoveStudentForm));
                 
                document.addEventListener('keydown', (e) => {
                       if (!document.querySelector('.modal-backdrop:not(.hidden)')) {
                             if (document.activeElement.tagName === 'BODY' && e.key.length === 1 && /^[a-zA-Z0-9\s]$/.test(e.key)) {
                                 searchBar.focus();
                             }
                       }
                     if (e.key === 'Escape') {
                           if(document.activeElement === searchBar) {
                               searchBar.value = '';
                               filterStudents();
                               searchBar.blur();
                           }
                         if (!feedbackModal.classList.contains('hidden')) feedbackModal.classList.add('hidden');
                         if (!summaryModal.classList.contains('hidden')) summaryModal.classList.add('hidden');
                         if (!resolveModal.classList.contains('hidden')) resolveModal.classList.add('hidden');
                         if (!editFeedbackModal.classList.contains('hidden')) editFeedbackModal.classList.add('hidden');
                         if (!studentManagementModal.classList.contains('hidden')) studentManagementModal.classList.add('hidden');
                         if (!manageClassesModal.classList.contains('hidden')) manageClassesModal.classList.add('hidden');
                         if (!studentReportModal.classList.contains('hidden')) studentReportModal.classList.add('hidden');
                         if (!viewScheduleModal.classList.contains('hidden')) viewScheduleModal.classList.add('hidden');
                         if (!aboutMeModal.classList.contains('hidden')) aboutMeModal.classList.add('hidden');
                         if (!appConfirmModal.classList.contains('hidden')) document.getElementById('app-confirm-cancel-btn').click();
                         if (!feedbackMatchModal.classList.contains('hidden')) feedbackMatchModal.classList.add('hidden');
                     }
                 });
            } catch (error) {
                 console.error(error);
                 document.body.innerHTML = `<div style="color:red; padding: 2rem;">${error.message}</div>`;
            }
        }
        
        main();
    </script>
</body>
</html>
