                }
                 if (currentClassMembers.some(s => s.name.toLowerCase() === name.toLowerCase())) {
                    showPersistentMessage(`Student with name "${name}" already exists in this class.`);
                    return;
                }

                try {
                    const studentRef = doc(db, `artifacts/${appId}/public/data/students`, id);
                    const studentSnap = await getDoc(studentRef);
                    const existingAboutMe = studentSnap.exists() ? (studentSnap.data().aboutMe || {}) : {};
