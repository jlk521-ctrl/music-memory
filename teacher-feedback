            async function bulkAddStudents(e) {
                e.preventDefault();
                const rawIds = document.getElementById('bulk-add-student-ids').value;
                const enteredIds = Array.from(new Set(
                    rawIds.split('\n').map(s => s.trim()).filter(Boolean)
                ));

                const invalidIds = enteredIds.filter(id => !/^\d+$/.test(id));
                const alreadyInClass = enteredIds.filter(id => /^\d+$/.test(id) && currentClassMembers.some(m => m.id === id));
                const validNewIds = enteredIds.filter(id => /^\d+$/.test(id) && !currentClassMembers.some(m => m.id === id));

                if (invalidIds.length > 0 || alreadyInClass.length > 0) {
                    const notes = [];
                    if (invalidIds.length > 0) notes.push(`Not valid numeric IDs (will be skipped): ${invalidIds.join(', ')}`);
                    if (alreadyInClass.length > 0) notes.push(`Already in this class (will be skipped): ${alreadyInClass.join(', ')}`);
                    const proceed = await showAppConfirm(
                        `${notes.join('\n')}\n\nAdd the remaining ${validNewIds.length} student(s) to ${currentClassId}?`,
                        'Add Students'
                    );
                    if (!proceed) return;
                }

                if (validNewIds.length === 0) {
                    showPersistentMessage("No new Student IDs to add.");
                    return;
                }

                try {
                    const batch = writeBatch(db);
                    const newMembers = [...currentClassMembers];

                    for (const id of validNewIds) {
                        const studentRef = doc(db, `artifacts/${appId}/public/data/students`, id);
                        const studentSnap = await getDoc(studentRef);

                        let name;
                        const existingAboutMe = studentSnap.exists() ? (studentSnap.data().aboutMe || {}) : {};
                        const existingGroups = studentSnap.exists() ? (studentSnap.data().groups || []) : [];
                        const newGroupsForMember = Array.from(new Set([...existingGroups, currentClassId]));
                        if (studentSnap.exists() && studentSnap.data().name) {
                            // Name already on file for this Student ID - reuse it.
                            name = studentSnap.data().name;
                            batch.update(studentRef, { groups: newGroupsForMember });
                        } else {
                            // No name on file yet - default the display name to the Student ID.
                            name = id;
                            batch.set(studentRef, { name, groups: [currentClassId], totalPositive: 0, totalNegative: 0 }, { merge: true });
                        }
                        newMembers.push({
                            id, name,
                            birthdate: existingAboutMe.birthdate || '',
                            icons: existingAboutMe.icons || [],
                            iconNotes: existingAboutMe.iconNotes || {},
                            groups: newGroupsForMember,
                            aboutMeSynced: true
                        });
                    }

                    const groupRef = doc(db, `artifacts/${appId}/public/data/groups`, currentClassId);
                    batch.update(groupRef, { members: newMembers });

                    await batch.commit();

                    showPersistentMessage(`Added ${validNewIds.length} student(s) to ${currentClassId}.`);
                    studentManagementModal.classList.add('hidden');
                    document.getElementById('bulk-add-student-form').reset();

                    await populateClassSelect();
                    await loadClass(currentClassId, true);

                } catch (error) {
                    console.error("Error bulk adding students:", error);
                    showPersistentMessage("Failed to add students. See console for details.");
                }
            }

