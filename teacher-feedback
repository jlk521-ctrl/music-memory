        import { initializeFirestore, collection, addDoc as _addDoc, getDocs as _getDocs, doc, getDoc as _getDoc, query, where, writeBatch as _writeBatch, setDoc as _setDoc, deleteDoc as _deleteDoc, updateDoc as _updateDoc, deleteField, increment } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

        // --- Firebase request counter ("requests today" badge) ---
        // Thin counting wrappers around the raw SDK calls, defined under the SAME names
        // the rest of this file already calls (getDoc, getDocs, addDoc, setDoc, updateDoc,
        // deleteDoc, writeBatch) so every existing call site everywhere in this file is
        // instrumented automatically - nothing else had to change. getDocs counts by the
        // number of documents actually returned (matching how Firestore bills reads), not
        // by 1-per-query. writeBatch counts each individual set/update/delete queued into
        // the batch once it's actually committed.
        function todayRequestCountKey() {
            // Self-contained (doesn't depend on the getLocalDateString() helper declared
            // inside main(), which isn't in scope up here at module level).
            const dateStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(new Date());
            return `firebaseRequestCounts_${dateStr}`;
        }
        function loadTodayRequestCounts() {
            try {
                const raw = safeGetItem(todayRequestCountKey());
                if (raw) return JSON.parse(raw);
            } catch (e) { /* ignore - falls through to a fresh count */ }
            return { reads: 0, writes: 0 };
        }
        let firebaseRequestCounts = loadTodayRequestCounts();
        function persistRequestCounts() {
            safeSetItem(todayRequestCountKey(), JSON.stringify(firebaseRequestCounts));
        }
        function updateRequestCounterDisplay() {
            persistRequestCounts();
            const el = document.getElementById('request-counter-display');
            if (el) el.textContent = `📊 ${firebaseRequestCounts.reads} reads · ${firebaseRequestCounts.writes} writes today`;
        }
        async function getDoc(...args) {
            const snap = await _getDoc(...args);
            firebaseRequestCounts.reads += 1;
            updateRequestCounterDisplay();
            return snap;
        }
        async function getDocs(...args) {
            const snap = await _getDocs(...args);
            firebaseRequestCounts.reads += snap.size;
            updateRequestCounterDisplay();
            return snap;
        }
        async function addDoc(...args) {
            const ref = await _addDoc(...args);
            firebaseRequestCounts.writes += 1;
            updateRequestCounterDisplay();
            return ref;
        }
        async function setDoc(...args) {
            const result = await _setDoc(...args);
            firebaseRequestCounts.writes += 1;
            updateRequestCounterDisplay();
            return result;
        }
        async function updateDoc(...args) {
            const result = await _updateDoc(...args);
            firebaseRequestCounts.writes += 1;
            updateRequestCounterDisplay();
            return result;
        }
        async function deleteDoc(...args) {
            const result = await _deleteDoc(...args);
            firebaseRequestCounts.writes += 1;
            updateRequestCounterDisplay();
            return result;
        }
        function writeBatch(...args) {
            const realBatch = _writeBatch(...args);
            let opCount = 0;
            return {
                set: (...a) => { opCount++; return realBatch.set(...a); },
                update: (...a) => { opCount++; return realBatch.update(...a); },
                delete: (...a) => { opCount++; return realBatch.delete(...a); },
                commit: async () => {
                    const result = await realBatch.commit();
                    firebaseRequestCounts.writes += opCount;
                    updateRequestCounterDisplay();
                    return result;
                }
            };
        }

