            async function commitInChunks(items, opType, chunkSize = 400) {
                for (let i = 0; i < items.length; i += chunkSize) {
                    const slice = items.slice(i, i + chunkSize);
                    if (slice.length === 0) continue;
                    const batch = writeBatch(db);
                    slice.forEach(item => {
                        if (opType === 'update') batch.update(item.ref, item.data);
                        else if (opType === 'set') batch.set(item.ref, item.data);
                        else if (opType === 'delete') batch.delete(item.ref);
                    });
                    await batch.commit();
                }
            }

            async function editClass(e) {
                e.preventDefault();
                const oldClassId = document.getElementById('edit-class-select').value;
                const newClassId = document.getElementById('edit-class-new-name').value.trim();
                const description = document.getElementById('edit-class-description').value.trim();

                if (!oldClassId) {
                    showPersistentMessage("Please select a class to edit.");
                    return;
                }
                if (!newClassId) {
                    showPersistentMessage("Please enter a class name.");
                    return;
                }

                const isRenaming = newClassId !== oldClassId;
                if (isRenaming && classSchedules.some(c => c.id === newClassId)) {
                    showPersistentMessage(`A class named "${newClassId}" already exists.`);
                    return;
                }

                const days = Array.from(document.querySelectorAll('.edit-class-day:checked')).map(cb => parseInt(cb.value, 10)).sort((a, b) => a - b);
                const startTime = document.getElementById('edit-class-start').value;
                const endTime = document.getElementById('edit-class-end').value;

                let scheduleForNewDoc; // used when renaming (we're writing a fresh doc)
                let scheduleUpdateForExisting; // used when only editing in place (may be deleteField())
                if (days.length === 0 && !startTime && !endTime) {
                    scheduleForNewDoc = undefined; // omit entirely on the new doc
                    scheduleUpdateForExisting = deleteField();
                } else if (days.length > 0 && startTime && endTime) {
                    const scheduleObj = { days, start: `${startTime}:00`, end: `${endTime}:00` };
                    scheduleForNewDoc = scheduleObj;
                    scheduleUpdateForExisting = scheduleObj;
                } else {
                    showPersistentMessage("Please select at least one meeting day and both start/end times together, or leave all of them blank to clear the schedule.");
                    return;
                }

                const submitBtn = document.getElementById('edit-class-submit');
                submitBtn.disabled = true;
                submitBtn.textContent = 'Saving...';

                try {
                    if (isRenaming) {
                        const oldGroupRef = doc(db, `artifacts/${appId}/public/data/groups`, oldClassId);
                        const oldGroupSnap = await getDoc(oldGroupRef);
                        if (!oldGroupSnap.exists()) {
                            showPersistentMessage("Could not find that class. It may have already been renamed or deleted.");
                            return;
                        }

                        // 1. Copy the group doc to the new ID (with the updated schedule/description) and remove the old one
                        // (Firestore doc IDs can't be renamed in place). Also patch the renamed
                        // class's own member entries so their denormalized `groups` field points
                        // at the new name instead of the old one.
                        const newGroupData = { ...oldGroupSnap.data() };
                        if (scheduleForNewDoc) newGroupData.schedule = scheduleForNewDoc;
                        else delete newGroupData.schedule;
                        if (description) newGroupData.description = description;
                        else delete newGroupData.description;
                        if (Array.isArray(newGroupData.members)) {
                            newGroupData.members = newGroupData.members.map(m => Array.isArray(m.groups)
                                ? { ...m, groups: m.groups.map(g => g === oldClassId ? newClassId : g) }
                                : m
                            );
                        }
                        await setDoc(doc(db, `artifacts/${appId}/public/data/groups`, newClassId), newGroupData);
                        await deleteDoc(oldGroupRef);

                        // 2. Point every student's groups list at the new name, and (since we're
                        // already reading every student doc here) propagate the rename out to
                        // each affected student's OTHER classes too, so none of their rosters are
                        // left with a stale reference to the old class name.
                        const studentsSnapshot = await getDocs(collection(db, `artifacts/${appId}/public/data/students`));
                        const studentUpdates = [];
                        const otherClassPropagations = []; // { studentId, newGroups }
                        studentsSnapshot.forEach(studentDoc => {
                            const groups = studentDoc.data().groups || [];
                            if (groups.includes(oldClassId)) {
                                const updatedGroups = groups.map(g => g === oldClassId ? newClassId : g);
                                studentUpdates.push({
                                    ref: studentDoc.ref,
                                    data: { groups: updatedGroups }
                                });
                                otherClassPropagations.push({ studentId: studentDoc.id, newGroups: updatedGroups });
                            }
                        });
                        await commitInChunks(studentUpdates, 'update');

                        // Now propagate each affected student's updated groups list out to
                        // their other classes' rosters (bounded by how many other classes each
                        // affected student is in - typically 1-3).
                        for (const { studentId, newGroups } of otherClassPropagations) {
                            await syncGroupsFieldAcrossRoster(studentId, newGroups.filter(g => g !== newClassId));
                        }

                        // 3. Re-tag every logged feedback entry under the new class name
                        const feedbackSnapshot = await getDocs(query(collection(db, `artifacts/${appId}/public/data/feedback`), where("class", "==", oldClassId)));
                        const feedbackUpdates = feedbackSnapshot.docs.map(d => ({ ref: d.ref, data: { class: newClassId } }));
                        await commitInChunks(feedbackUpdates, 'update');

                        // 4. Migrate saved lesson objective/notes docs (keyed "<classId>_<date>")
                        const notesSnapshot = await getDocs(query(collection(db, `artifacts/${appId}/public/data/lessonNotes`), where("class", "==", oldClassId)));
                        const noteWrites = [];
                        const noteDeletes = [];
                        notesSnapshot.forEach(noteDoc => {
                            const data = noteDoc.data();
                            const suffix = noteDoc.id.startsWith(`${oldClassId}_`)
                                ? noteDoc.id.slice(oldClassId.length + 1)
                                : getLocalDateString();
                            noteWrites.push({
                                ref: doc(db, `artifacts/${appId}/public/data/lessonNotes`, `${newClassId}_${suffix}`),
                                data: { ...data, class: newClassId }
                            });
                            noteDeletes.push({ ref: noteDoc.ref });
                        });
                        await commitInChunks(noteWrites, 'set');
                        await commitInChunks(noteDeletes, 'delete');

                        showPersistentMessage(`Renamed "${oldClassId}" to "${newClassId}" and updated its schedule.`);

                    } else {
                        // Same name - just update the schedule/description in place
                        const updateData = { schedule: scheduleUpdateForExisting };
                        updateData.description = description ? description : deleteField();
                        await updateDoc(doc(db, `artifacts/${appId}/public/data/groups`, oldClassId), updateData);
                        showPersistentMessage(
                            scheduleUpdateForExisting && typeof scheduleUpdateForExisting === 'object' && scheduleUpdateForExisting.days
                                ? `Updated schedule for "${oldClassId}".`
                                : `Cleared schedule for "${oldClassId}".`
                        );
                    }

                    await populateClassSelect();
                    populateManageClassesSelects();

                    const finalClassId = isRenaming ? newClassId : oldClassId;
                    document.getElementById('edit-class-select').value = finalClassId;
                    applyEditFieldsForClass(finalClassId);

                    if (currentClassId === oldClassId) {
                        classSelect.value = finalClassId;
                        autoSelectPerformed = true;
                        await loadClass(finalClassId, true);
                    }

                } catch (error) {
                    console.error("Error editing class:", error);
                    showPersistentMessage("Failed to fully save the changes. Some records may already be updated - check the console before retrying.");
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Save Changes';
                }
            }

            async function deleteClass(e) {
                e.preventDefault();
                const select = document.getElementById('delete-class-select');
                const classId = select.value;
                const confirmName = document.getElementById('delete-class-confirm').value.trim();

                if (!classId) {
                    showPersistentMessage("Please select a class to delete.");
                    return;
                }
                if (classId !== confirmName) {
                    showPersistentMessage("Confirmation name does not match the selected class.");
                    return;
                }

                try {
                    const batch = writeBatch(db);

                    // Remove this class from every student's groups list
                    const studentsRef = collection(db, `artifacts/${appId}/public/data/students`);
                    const studentsSnapshot = await getDocs(studentsRef);
                    studentsSnapshot.forEach(studentDoc => {
                        const groups = studentDoc.data().groups || [];
                        if (groups.includes(classId)) {
                            batch.update(studentDoc.ref, { groups: groups.filter(g => g !== classId) });
                        }
                    });

                    // Delete all feedback entries logged under this class
                    const feedbackQuery = query(collection(db, `artifacts/${appId}/public/data/feedback`), where("class", "==", classId));
                    const feedbackSnapshot = await getDocs(feedbackQuery);
                    feedbackSnapshot.forEach(feedbackDoc => batch.delete(feedbackDoc.ref));

                    // Delete the class itself
                    batch.delete(doc(db, `artifacts/${appId}/public/data/groups`, classId));

                    await batch.commit();

                    showPersistentMessage(`Deleted class "${classId}".`);
                    document.getElementById('delete-class-form').reset();
                    document.getElementById('delete-class-submit').disabled = true;

                    await populateClassSelect();
                    populateManageClassesSelects();
                    if (currentClassId === classId) {
                        classSelect.value = '';
                        await loadClass('');
                    }

                } catch (error) {
                    console.error("Error deleting class:", error);
                    showPersistentMessage("Failed to delete class. See console for details.");
                }
            }

